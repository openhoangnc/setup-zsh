write_gcloud_env() {
    # path.zsh.inc/completion.zsh.inc are generated by install.sh; guard on them
    # so the block stays harmless if the SDK is later removed by hand.
    echo "Updating env.zsh..."
    local content="if [[ -f \"\$HOME/.local/google-cloud-sdk/path.zsh.inc\" ]]; then\n  source \"\$HOME/.local/google-cloud-sdk/path.zsh.inc\"\nfi\nif [[ -f \"\$HOME/.local/google-cloud-sdk/completion.zsh.inc\" ]]; then\n  source \"\$HOME/.local/google-cloud-sdk/completion.zsh.inc\"\nfi"
    update_env_block "GoogleCloudSDK" "$content"
}

install_gcloud() {
    require_latest "gcloud CLI" "$LATEST_GCLOUD" || return 1
    local sdk_root="$HOME/.local/google-cloud-sdk"

    # An existing install we own updates through gcloud's own component manager:
    # it keeps every installed component (gke-gcloud-auth-plugin, alpha/beta, ...)
    # and only fetches the changed pieces. A gcloud we did not place (e.g. a
    # Homebrew cask, which blocks `components update`) is left alone and the
    # tarball goes into ~/.local instead.
    if [[ -x "$sdk_root/bin/gcloud" ]]; then
        echo -e "${BLUE}Updating gcloud CLI to v${LATEST_GCLOUD} via components update...${NC}"
        if ! "$sdk_root/bin/gcloud" components update --quiet; then
            echo -e "${RED}Error: Failed to update the gcloud CLI.${NC}"
            return 1
        fi
        write_gcloud_env
        echo -e "${GREEN}✓ gcloud CLI v${LATEST_GCLOUD} updated successfully!${NC}"
        return 0
    fi

    echo -e "${BLUE}Installing gcloud CLI v${LATEST_GCLOUD}...${NC}"
    local download_url="https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-${LATEST_GCLOUD}-darwin-${GCLOUD_ARCH}.tar.gz"
    local temp_tar=$(mktemp /tmp/gcloud.XXXXXX)

    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_tar"; then
        echo -e "${RED}Error: Failed to download the gcloud CLI.${NC}"
        rm -f "$temp_tar"
        return 1
    fi

    echo "Extracting gcloud CLI..."
    local temp_extract_dir
    temp_extract_dir=$(mktemp -d /tmp/gcloud_extract.XXXXXX)
    if ! tar -xzf "$temp_tar" -C "$temp_extract_dir"; then
        echo -e "${RED}Error: Failed to extract the gcloud CLI.${NC}"
        rm -f "$temp_tar"
        rm -rf "$temp_extract_dir"
        return 1
    fi

    echo "Installing to ~/.local/google-cloud-sdk..."
    mkdir -p "$HOME/.local"
    rm -rf "$sdk_root"
    if ! mv "$temp_extract_dir/google-cloud-sdk" "$sdk_root"; then
        echo -e "${RED}Error: Failed to move the gcloud CLI into ~/.local/google-cloud-sdk.${NC}"
        rm -f "$temp_tar"
        rm -rf "$temp_extract_dir"
        return 1
    fi

    rm -f "$temp_tar"
    rm -rf "$temp_extract_dir"

    # install.sh only precompiles the SDK and writes the shell rc snippets; PATH
    # and completion are wired up by env.zsh below, so keep it from touching any
    # dotfile. The darwin tarball ships a bundled Python, so nothing is fetched.
    echo "Running the gcloud install script..."
    if ! "$sdk_root/install.sh" --quiet --usage-reporting=false --path-update=false --command-completion=false; then
        echo -e "${YELLOW}Warning: the gcloud install script reported problems. The CLI is in place; run '${sdk_root}/install.sh' manually if it misbehaves.${NC}"
    fi

    write_gcloud_env

    echo -e "${GREEN}✓ gcloud CLI v${LATEST_GCLOUD} installed to ~/.local/google-cloud-sdk!${NC}"
    echo -e "${YELLOW}Run 'gcloud init' to authenticate and pick a project.${NC}"
}

# ---- Per-manager upgrade commands -------------------------------------------
# Each takes the resolved manager binary and returns non-zero on failure. They
# are dispatched by GLOBAL_PM_ORDER, so adding a manager here plus a matching
# <pm>_bin resolver is all it takes to have it updated and shown in details.

pm_upgrade_npm() {
    local bin="$1" pkgs pkg rc=0
    pkgs=$(npm_outdated_list)
    if [[ -z "$pkgs" ]]; then
        echo "Nothing to update."
        return 0
    fi
    # Install each outdated package at @latest (npm and corepack are excluded by
    # npm_outdated_list because the Node.js tarball owns them).
    while IFS= read -r pkg; do
        [[ -n "$pkg" ]] || continue
        echo "Installing ${pkg}..."
        if ! run_js_pm "$bin" install -g "$pkg"; then
            echo -e "${YELLOW}Warning: failed to update ${pkg}.${NC}"
            rc=1
        fi
    done <<< "$pkgs"
    return $rc
}

pm_upgrade_pnpm() {
    # --latest ignores the recorded ranges so pinned globals actually move.
    run_js_pm "$1" update -g --latest
}

pm_upgrade_yarn() {
    # Yarn Classic only (yarn_bin already filtered out Berry).
    run_js_pm "$1" global upgrade --latest
}

pm_upgrade_bun() {
    local bin="$1"
    # Older Bun releases have no global update; ask the binary rather than
    # assume, so the step degrades to a note instead of an error.
    if "$bin" update --help 2>&1 | grep -q -- '--global'; then
        "$bin" update --global
    else
        echo "This Bun version has no global update command. Skipping."
    fi
}

pm_upgrade_brew() {
    local bin="$1" rc=0
    if ! "$bin" update; then
        echo -e "${YELLOW}Warning: 'brew update' reported problems.${NC}"
    fi
    # No --greedy: casks that ship their own auto-updater keep managing
    # themselves rather than being reinstalled behind their own back.
    "$bin" upgrade || rc=1
    return $rc
}

pm_upgrade_uv() {
    # uv exposes no "outdated" query, so the upgrade is always attempted; it
    # prints "Nothing to upgrade" and exits 0 when everything is current.
    "$1" tool upgrade --all
}

pm_upgrade_pipx() {
    "$1" upgrade-all
}

pm_upgrade_gem() {
    # gem_bin already excluded Apple's system Ruby, so this is a user gemset.
    # --no-document skips local rdoc/ri generation (faster, quieter).
    "$1" update --no-document
}

pm_upgrade_composer() {
    "$1" global update
}

pm_upgrade_cargo() {
    # cargo_bin guaranteed the cargo-update plugin is present.
    "$1" install-update -a
}

# ---- Per-manager cache cleanup ----------------------------------------------
# Reclaim the download/store caches an update just filled. Best-effort: a
# cleanup that fails only warns and never fails the update. Managers with no
# cache-clean command (pipx, cargo) simply define no function and are skipped.

pm_cleanup_npm() {
    run_js_pm "$1" cache clean --force
}

pm_cleanup_pnpm() {
    # Drops packages in the content-addressable store that nothing references.
    run_js_pm "$1" store prune
}

pm_cleanup_yarn() {
    run_js_pm "$1" cache clean
}

pm_cleanup_bun() {
    "$1" pm cache rm
}

pm_cleanup_brew() {
    # Removes stale lock files and outdated downloads for all formulae & casks.
    "$1" cleanup
}

pm_cleanup_uv() {
    # prune (not clean) keeps entries still in use and only drops dangling ones.
    "$1" cache prune
}

pm_cleanup_gem() {
    # RubyGems has no cache-only command; cleanup removes superseded gem
    # versions (and their cached .gem files), keeping the newest of each.
    "$1" cleanup
}

pm_cleanup_composer() {
    "$1" clear-cache
}

# ---- Per-manager detail views -----------------------------------------------
# Each prints an indented, human-readable outdated report. Managers without an
# outdated query just state the command their update will run.

pm_detail_npm() {
    local out
    out=$("$1" outdated -g --parseable --fetch-timeout=10000 --fetch-retries=0 2>/dev/null | awk -F: '
        $4 != "" {
            name=$4; sub(/@[^@]*$/, "", name)
            latest=$4; sub(/^.*@/, "", latest)
            cur=$3; sub(/^.*@/, "", cur)
            if (name=="npm" || name=="corepack") next
            printf "    %-30s %s -> %s\n", name, cur, latest
        }')
    if [[ -n "$out" ]]; then echo "$out"; else echo "    Up to date."; fi
}

pm_detail_pnpm() {
    local out
    out=$(run_js_pm "$1" outdated -g 2>/dev/null)
    if [[ -n "$out" ]]; then echo "$out" | sed 's/^/    /'; else echo "    Up to date."; fi
}

pm_detail_yarn() {
    echo "    Yarn Classic has no global outdated report."
    echo "    Update runs: yarn global upgrade --latest"
}

pm_detail_bun() {
    echo "    Bun has no outdated query. Update runs: bun update --global"
}

pm_detail_brew() {
    local out
    out=$(env HOMEBREW_NO_AUTO_UPDATE=1 "$1" outdated --verbose 2>/dev/null)
    if [[ -n "$out" ]]; then echo "$out" | sed 's/^/    /'; else echo "    Up to date."; fi
}

pm_detail_uv() {
    local out
    out=$("$1" tool list 2>/dev/null)
    [[ -n "$out" ]] && echo "$out" | sed 's/^/    /'
    echo "    Update runs: uv tool upgrade --all"
}

pm_detail_pipx() {
    local out
    out=$("$1" list --short 2>/dev/null)
    [[ -n "$out" ]] && { echo "    Installed:"; echo "$out" | sed 's/^/      /'; }
    echo "    Update runs: pipx upgrade-all"
}

pm_detail_gem() {
    local out
    out=$("$1" outdated 2>/dev/null)
    if [[ -n "$out" ]]; then echo "$out" | sed 's/^/    /'; else echo "    Up to date."; fi
}

pm_detail_composer() {
    local out
    out=$("$1" global outdated --direct 2>/dev/null)
    if [[ -n "$out" ]]; then echo "$out" | sed 's/^/    /'; else echo "    Up to date."; fi
}

pm_detail_cargo() {
    local out
    out=$("$1" install-update -l 2>/dev/null)
    if [[ -n "$out" ]]; then echo "$out" | sed 's/^/    /'; else echo "    No cargo-installed binaries."; fi
}

# Full-screen breakdown of every available manager, opened with Enter on the
# Global Packages row. Runs each manager's detail view on demand (some hit the
# network), then waits for a key and returns to the menu.
show_globals_details() {
    local pms pm bin _key
    printf "\033[?25h"
    printf '\033[2J\033[H'
    echo -e "${BLUE}==================================================${NC}"
    echo -e "${BLUE}        📦 Global Packages — outdated details${NC}"
    echo -e "${BLUE}==================================================${NC}"
    pms="$(detect_global_pms)"
    if [[ -z "$pms" ]]; then
        echo -e "${YELLOW}No supported global package manager found.${NC}"
    else
        echo -e "${CYAN}Checking each manager (some queries hit the network)...${NC}"
        echo ""
        for pm in $GLOBAL_PM_ORDER; do
            bin="$(${pm}_bin)"
            [[ -n "$bin" ]] || continue
            echo -e "${PURPLE}> ${pm}${NC} ${YELLOW}(${bin})${NC}"
            pm_detail_"$pm" "$bin"
            echo ""
        done
    fi
    echo -e "${BLUE}==================================================${NC}"
    echo -n -e "${CYAN}Press any key to return to the menu...${NC}"
    IFS= read -r -s -n 1 _key 2>/dev/null
    printf "\033[?25l"
}

update_global_packages() {
    echo -e "${BLUE}Updating global packages...${NC}"
    local failed=0 pm bin
    for pm in $GLOBAL_PM_ORDER; do
        bin="$(${pm}_bin)"
        [[ -n "$bin" ]] || continue
        echo -e "${BLUE}> ${pm}${NC}"
        if ! pm_upgrade_"$pm" "$bin"; then
            echo -e "${YELLOW}Warning: ${pm} update reported problems.${NC}"
            failed=1
        fi
    done
    # Reclaim the caches the upgrades just filled. This is maintenance, not part
    # of the update result: cleanup problems only warn and never flip $failed,
    # so they can't force the post-batch "Press Enter" pause.
    echo -e "${BLUE}Cleaning package caches...${NC}"
    for pm in $GLOBAL_PM_ORDER; do
        bin="$(${pm}_bin)"
        [[ -n "$bin" ]] || continue
        declare -f pm_cleanup_"$pm" >/dev/null 2>&1 || continue
        echo -e "${BLUE}> ${pm}${NC}"
        pm_cleanup_"$pm" "$bin" || echo -e "${YELLOW}Warning: ${pm} cache cleanup reported problems.${NC}"
    done

    if [ "$failed" -eq 1 ]; then
        echo -e "${YELLOW}Some global packages could not be updated - see the messages above.${NC}"
        return 1
    fi
    echo -e "${GREEN}✓ Global packages updated and caches cleaned!${NC}"
}
# Selection states (0 = unselected, 1 = selected)
SEL_1=0; SEL_2=0; SEL_3=0; SEL_4=0; SEL_5=0; SEL_6=0; SEL_7=0; SEL_8=0; SEL_9=0; SEL_10=0; SEL_11=0; SEL_12=0; SEL_13=0; SEL_14=0; SEL_15=0; SEL_16=0; SEL_17=0; SEL_18=0; SEL_19=0
CURSOR=1
do_install=0
globals_ran=0
fresh_install=0

toggle_all() {
    local any_unselected=0
    for i in {1..19}; do
        eval "local val=\$SEL_$i"
        if [ "$val" -eq 0 ]; then
            any_unselected=1
            break
        fi
    done

    for i in {1..19}; do
        if [ "$any_unselected" -eq 1 ]; then
            eval "SEL_$i=1"
        else
            eval "SEL_$i=0"
        fi
    done
}

globals_outdated() {
    # Only npm and Homebrew are cheap to query up front, so they alone decide
    # whether this row counts as outdated; uv and Bun are updated on demand.
    [[ "$OUTDATED_NPM" =~ ^[1-9][0-9]*$ ]] && return 0
    [[ "$OUTDATED_BREW" =~ ^[1-9][0-9]*$ ]] && return 0
    return 1
}

python_outdated() {
    # Selected when either part is installed and the pair is incomplete or outdated
    [[ -n "$INST_PYTHON" || -n "$INST_UV" ]] || return 1
    [[ -z "$INST_PYTHON" || -z "$INST_UV" ]] && return 0
    is_outdated "$INST_PYTHON" "$LATEST_PYTHON" && return 0
    is_outdated "$INST_UV" "$LATEST_UV" && return 0
    return 1
}

select_outdated() {
    for i in {1..19}; do
        eval "SEL_$i=0"
    done
    is_outdated "$INST_BUN" "$LATEST_BUN" && SEL_1=1
    is_outdated "$INST_GO" "$LATEST_GO" && SEL_2=1
    is_outdated "$INST_JDK" "$LATEST_JDK" && SEL_3=1
    is_outdated "$INST_NODE" "$LATEST_NODE" && SEL_4=1
    python_outdated && SEL_5=1
    is_outdated "$INST_RUST" "$LATEST_RUST" && SEL_6=1
    is_outdated "$INST_GCLOUD" "$LATEST_GCLOUD" && SEL_7=1
    is_outdated "$INST_HOMEBREW" "$LATEST_HOMEBREW" && SEL_9=1
    is_outdated "$INST_ORB" "$LATEST_ORB" && SEL_10=1
    is_outdated "$INST_ANDROID_STUDIO" "$LATEST_ANDROID_STUDIO" && SEL_11=1
    is_outdated "$INST_VSCODE" "$LATEST_VSCODE" && SEL_12=1
    is_outdated "$INST_DBEAVER" "$LATEST_DBEAVER" && SEL_13=1
    is_outdated "$INST_COMPASS" "$LATEST_COMPASS" && SEL_14=1
    is_outdated "$INST_ANTIGRAVITY" "$LATEST_ANTIGRAVITY" && SEL_15=1
    is_outdated "$INST_CLAUDE" "$LATEST_CLAUDE" && SEL_16=1
    is_outdated "$INST_CODEX" "$LATEST_CODEX" && SEL_17=1
    is_outdated "$INST_CHROME" "$LATEST_CHROME" && SEL_18=1
    globals_outdated && SEL_19=1
}

has_outdated_tools() {
    is_outdated "$INST_BUN" "$LATEST_BUN" && return 0
    is_outdated "$INST_GO" "$LATEST_GO" && return 0
    is_outdated "$INST_JDK" "$LATEST_JDK" && return 0
    is_outdated "$INST_NODE" "$LATEST_NODE" && return 0
    python_outdated && return 0
    is_outdated "$INST_RUST" "$LATEST_RUST" && return 0
    is_outdated "$INST_GCLOUD" "$LATEST_GCLOUD" && return 0
    is_outdated "$INST_HOMEBREW" "$LATEST_HOMEBREW" && return 0
    is_outdated "$INST_ORB" "$LATEST_ORB" && return 0
    is_outdated "$INST_ANDROID_STUDIO" "$LATEST_ANDROID_STUDIO" && return 0
    is_outdated "$INST_VSCODE" "$LATEST_VSCODE" && return 0
    is_outdated "$INST_DBEAVER" "$LATEST_DBEAVER" && return 0
    is_outdated "$INST_COMPASS" "$LATEST_COMPASS" && return 0
    is_outdated "$INST_ANTIGRAVITY" "$LATEST_ANTIGRAVITY" && return 0
    is_outdated "$INST_CLAUDE" "$LATEST_CLAUDE" && return 0
    is_outdated "$INST_CODEX" "$LATEST_CODEX" && return 0
    is_outdated "$INST_CHROME" "$LATEST_CHROME" && return 0
    globals_outdated && return 0
    return 1
}

installed_version_for() {
    # Installed version behind menu row $1 — empty means the row would be a
    # first-time install rather than an update. Python & uv report empty unless
    # both halves are present, since the missing half is a fresh install too.
    case "$1" in
        1) echo "$INST_BUN" ;;
        2) echo "$INST_GO" ;;
        3) echo "$INST_JDK" ;;
        4) echo "$INST_NODE" ;;
        5) [[ -n "$INST_PYTHON" && -n "$INST_UV" ]] && echo "$INST_PYTHON" ;;
        6) echo "$INST_RUST" ;;
        7) echo "$INST_GCLOUD" ;;
        8) echo "$INST_GIT" ;;
        9) echo "$INST_HOMEBREW" ;;
        10) echo "$INST_ORB" ;;
        11) echo "$INST_ANDROID_STUDIO" ;;
        12) echo "$INST_VSCODE" ;;
        13) echo "$INST_DBEAVER" ;;
        14) echo "$INST_COMPASS" ;;
        15) echo "$INST_ANTIGRAVITY" ;;
        16) echo "$INST_CLAUDE" ;;
        17) echo "$INST_CODEX" ;;
        18) echo "$INST_CHROME" ;;
        # Updating packages is never a first-time install of anything.
        19) echo "$GLOBAL_PMS" ;;
    esac
}

refresh_installed_tools() {
    INST_BUN=$(detect_bun)
    INST_GO=$(detect_go)
    INST_NODE=$(detect_node)
    INST_ORB=$(detect_orb)
    INST_VSCODE=$(detect_vscode)
    INST_PYTHON=$(detect_python)
    INST_UV=$(detect_uv)
    INST_JDK=$(detect_jdk)
    INST_CLAUDE=$(detect_claude)
    INST_RUST=$(detect_rust)
    INST_GIT=$(detect_git)
    INST_HOMEBREW=$(detect_homebrew)
    INST_COMPASS=$(detect_compass)
    INST_DBEAVER=$(detect_dbeaver)
    INST_CHROME=$(detect_chrome)
    INST_ANDROID_STUDIO=$(detect_android_studio)
    INST_CODEX=$(detect_codex)
    INST_ANTIGRAVITY=$(detect_antigravity)
    INST_GCLOUD=$(detect_gcloud)
    GLOBAL_PMS=$(detect_global_pms)
}

refresh_installed_tools

# Handle CLI flags (--help/unknown were handled before the version checks)
BATCH_MODE=0
if [[ "${1:-}" == "--update-all" || "${1:-}" == "update-all" || "${1:-}" == "-u" ]]; then
    BATCH_MODE=1
    select_outdated
    do_install=1
elif [[ "${1:-}" == "--all" || "${1:-}" == "-a" ]]; then
    BATCH_MODE=1
    toggle_all
    do_install=1
else
    printf "\033[?25l"
fi

# Main loop
while true; do
    if [ "$do_install" -eq 0 ]; then
        printf "\033[?25l"
        max_cursor=22
        if has_outdated_tools; then
            max_cursor=23
        fi
        if [ "$CURSOR" -gt "$max_cursor" ]; then
            CURSOR=$max_cursor
        fi

        # Buffer entire menu, then flush at once to avoid flicker
        menu_buf=$(
            echo -e "${BLUE}==================================================${NC}\033[K"
            echo -e "${BLUE}        🛠️  setup-zsh Developer Tool Installer${NC}\033[K"
            echo -e "${BLUE}==================================================${NC}\033[K"
            echo -e "Arrows navigate · Space toggles · Enter toggles (Enter on 📦 Global Packages shows details).\033[K"
            echo ""
            echo -e "${PURPLE}── Languages & Runtimes ─────────────────────────${NC}\033[K"
            show_line 1 "$(show_checkbox "$SEL_1")  1) 🥟 Bun                $(format_status "$INST_BUN" "$LATEST_BUN")"
            show_line 2 "$(show_checkbox "$SEL_2")  2) 🐹 Go (Golang)        $(format_status "$INST_GO" "$LATEST_GO")"
            show_line 3 "$(show_checkbox "$SEL_3")  3) ☕ JDK (Temurin LTS)  $(format_status "$INST_JDK" "$LATEST_JDK")"
            show_line 4 "$(show_checkbox "$SEL_4")  4) 🟢 Node.js            $(format_status "$INST_NODE" "$LATEST_NODE")"
            show_line 5 "$(show_checkbox "$SEL_5")  5) 🐍 Python & uv        $(format_python_status "$INST_PYTHON" "$INST_UV" "$LATEST_PYTHON" "$LATEST_UV")"
            show_line 6 "$(show_checkbox "$SEL_6")  6) 🦀 Rust               $(format_status "$INST_RUST" "$LATEST_RUST")"
            echo -e "${PURPLE}── Dev Tools & Infrastructure ───────────────────${NC}\033[K"
            # ⛅ (U+26C5), not ☁️ (U+2601): the latter is East Asian "neutral", so
            # terminals disagree on whether to reserve one cell or two and the row
            # cannot be padded to line up everywhere. U+26C5 is "wide" like ☕, so
            # every terminal reserves the same two cells as the other rows' emoji.
            show_line 7 "$(show_checkbox "$SEL_7")  7) ⛅ gcloud CLI         $(format_status "$INST_GCLOUD" "$LATEST_GCLOUD")"
            show_line 8 "$(show_checkbox "$SEL_8")  8) 🐙 Git                $(format_git_status "$INST_GIT")"
            show_line 9 "$(show_checkbox "$SEL_9")  9) 🍺 Homebrew           $(format_status "$INST_HOMEBREW" "$LATEST_HOMEBREW")"
            show_line 10 "$(show_checkbox "$SEL_10") 10) 🔮 OrbStack (Docker)  $(format_status "$INST_ORB" "$LATEST_ORB")"
            echo -e "${PURPLE}── IDEs & Editors ───────────────────────────────${NC}\033[K"
            show_line 11 "$(show_checkbox "$SEL_11") 11) 🤖 Android Studio     $(format_status "$INST_ANDROID_STUDIO" "$LATEST_ANDROID_STUDIO")"
            show_line 12 "$(show_checkbox "$SEL_12") 12) 🟦 VSCode             $(format_status "$INST_VSCODE" "$LATEST_VSCODE")"
            echo -e "${PURPLE}── Database Tools ───────────────────────────────${NC}\033[K"
            show_line 13 "$(show_checkbox "$SEL_13") 13) 🦫 DBeaver            $(format_status "$INST_DBEAVER" "$LATEST_DBEAVER")"
            show_line 14 "$(show_checkbox "$SEL_14") 14) 🧭 MongoDB Compass    $(format_status "$INST_COMPASS" "$LATEST_COMPASS")"
            echo -e "${PURPLE}── AI & Applications & Utilities ────────────────${NC}\033[K"
            show_line 15 "$(show_checkbox "$SEL_15") 15) 🚀 Antigravity        $(format_status "$INST_ANTIGRAVITY" "$LATEST_ANTIGRAVITY")"
            show_line 16 "$(show_checkbox "$SEL_16") 16) 💥 Claude             $(format_status "$INST_CLAUDE" "$LATEST_CLAUDE")"
            show_line 17 "$(show_checkbox "$SEL_17") 17) 🧠 Codex              $(format_status "$INST_CODEX" "$LATEST_CODEX")"
            show_line 18 "$(show_checkbox "$SEL_18") 18) 🌐 Google Chrome      $(format_status "$INST_CHROME" "$LATEST_CHROME")"
            echo -e "${PURPLE}── Global Packages ──────────────────────────────${NC}\033[K"
            show_line 19 "$(show_checkbox "$SEL_19") 19) 📦 Global Packages    $(format_globals_status "$GLOBAL_PMS" "$OUTDATED_NPM" "$OUTDATED_BREW")"
            echo -e "\033[K"
            if has_outdated_tools; then
                echo -e "$(show_action_item 20 "[I] Install")  $(show_action_item 21 "[A] Toggle All")  $(show_action_item 22 "[U] Select Outdated")  $(show_action_item 23 "[E] Exit")\033[K"
            else
                echo -e "$(show_action_item 20 "[I] Install")    $(show_action_item 21 "[A] Toggle All")    $(show_action_item 22 "[E] Exit")\033[K"
            fi
            echo -e "${BLUE}==================================================${NC}\033[K"
        )
        printf '\033[2J\033[H%s\n' "$menu_buf"
        
        # Read one character (escape sequences check)
        if ! IFS= read -r -s -n 1 key 2>/dev/null; then
            echo -e "\n${YELLOW}Input closed. Exiting.${NC}"
            exit 1
        fi
        action=""

        if [[ "$key" = $'\e' ]]; then
            next_chars=""
            read -r -s -n 2 -t 1 next_chars 2>/dev/null
            if [[ "$next_chars" = "[A" || "$next_chars" = "OA" ]]; then
                action="UP"
            elif [[ "$next_chars" = "[B" || "$next_chars" = "OB" ]]; then
                action="DOWN"
            elif [[ "$next_chars" = "[C" || "$next_chars" = "OC" ]]; then
                action="RIGHT"
            elif [[ "$next_chars" = "[D" || "$next_chars" = "OD" ]]; then
                action="LEFT"
            elif [[ -z "$next_chars" ]]; then
                # Bare Escape: quit
                action="EXIT"
            fi
        elif [[ "$key" = " " ]]; then
            action="SPACE"
        elif [[ -z "$key" ]]; then
            action="ENTER"
        elif [[ "$key" = "i" || "$key" = "I" ]]; then
            action="INSTALL"
        elif [[ "$key" = "a" || "$key" = "A" ]]; then
            action="ALL"
        elif [[ "$key" = "u" || "$key" = "U" ]]; then
            if has_outdated_tools; then
                action="OUTDATED"
            fi
        elif [[ "$key" = "e" || "$key" = "E" || "$key" = "q" || "$key" = "Q" ]]; then
            action="EXIT"
        elif [[ "$key" == "1" ]]; then
            # Item 1, or 10-19 when a second digit follows quickly
            second=""
            IFS= read -r -s -n 1 -t 1 second 2>/dev/null
            if [[ "$second" =~ ^[0-9]$ ]]; then
                action="NUM_1$second"
            else
                if [[ "$second" == $'\e' ]]; then
                    read -r -s -n 2 -t 1 _discard 2>/dev/null
                fi
                action="NUM_1"
            fi
        elif [[ "$key" =~ ^[2-9]$ ]]; then
            action="NUM_$key"
        fi
        
        case "$action" in
            UP)
                if [ "$CURSOR" -ge 20 ]; then
                    CURSOR=19
                else
                    CURSOR=$((CURSOR - 1))
                    if [ "$CURSOR" -lt 1 ]; then
                        CURSOR=$max_cursor
                    fi
                fi
                ;;
            DOWN)
                if [ "$CURSOR" -eq 19 ]; then
                    CURSOR=20
                elif [ "$CURSOR" -ge 20 ]; then
                    CURSOR=1
                else
                    CURSOR=$((CURSOR + 1))
                fi
                ;;
            LEFT)
                if [ "$CURSOR" -ge 20 ]; then
                    CURSOR=$((CURSOR - 1))
                    if [ "$CURSOR" -lt 20 ]; then
                        CURSOR=$max_cursor
                    fi
                else
                    CURSOR=$((CURSOR - 1))
                    if [ "$CURSOR" -lt 1 ]; then
                        CURSOR=$max_cursor
                    fi
                fi
                ;;
            RIGHT)
                if [ "$CURSOR" -ge 20 ]; then
                    CURSOR=$((CURSOR + 1))
                    if [ "$CURSOR" -gt "$max_cursor" ]; then
                        CURSOR=20
                    fi
                else
                    CURSOR=$((CURSOR + 1))
                    if [ "$CURSOR" -gt "$max_cursor" ]; then
                        CURSOR=1
                    fi
                fi
                ;;
            SPACE|ENTER)
                if [ "$CURSOR" -eq 19 ] && [ "$action" = "ENTER" ]; then
                    # Enter on Global Packages = view the per-manager breakdown.
                    # Space or the number key still toggle the row for install.
                    show_globals_details
                elif [ "$CURSOR" -ge 1 ] && [ "$CURSOR" -le 19 ]; then
                    eval "SEL_$CURSOR=\$((1 - SEL_$CURSOR))"
                elif [ "$CURSOR" -eq 20 ]; then
                    do_install=1
                elif [ "$CURSOR" -eq 21 ]; then
                    toggle_all
                elif [ "$CURSOR" -eq 22 ]; then
                    if has_outdated_tools; then
                        select_outdated
                    else
                        echo -e "\n${BLUE}Goodbye!${NC}"
                        exit 0
                    fi
                elif [ "$CURSOR" -eq 23 ]; then
                    echo -e "\n${BLUE}Goodbye!${NC}"
                    exit 0
                fi
                ;;
            NUM_*)
                num="${action#NUM_}"
                eval "SEL_$num=\$((1 - SEL_$num))"
                ;;
            INSTALL)
                do_install=1
                ;;
            ALL)
                toggle_all
                ;;
            OUTDATED)
                select_outdated
                ;;
            EXIT)
                echo -e "\n${BLUE}Goodbye!${NC}"
                exit 0
                ;;
        esac
    fi
    
    if [ "$do_install" -eq 1 ]; then
        do_install=0 # Reset flag
        printf "\033[?25h"

        # Count selected tools
        count=0
        for i in {1..19}; do
            eval "val=\$SEL_$i"
            if [ "$val" -eq 1 ]; then
                count=$((count + 1))
            fi
        done

        if [ "$count" -eq 0 ]; then
            if [ "$BATCH_MODE" -eq 1 ]; then
                echo -e "\n${GREEN}Everything is already up to date. Nothing to do.${NC}"
                exit 0
            fi
            echo -e "\n${YELLOW}No tools selected. Use Up/Down + Space or numbers to select.${NC}"
            echo -e "\nPress Enter to continue..."
            read -r || exit 1
            continue
        fi
        
        echo -e "\n${BLUE}Preparing installation...${NC}\n"
        
        # Check confirm_reinstall upfront for tools that are already up-to-date
        if [ "$SEL_1" -eq 1 ] && is_up_to_date "$INST_BUN" "$LATEST_BUN" && ! confirm_reinstall "Bun" "$INST_BUN" "$LATEST_BUN"; then
            SEL_1=0
        fi
        if [ "$SEL_2" -eq 1 ] && is_up_to_date "$INST_GO" "$LATEST_GO" && ! confirm_reinstall "Go" "$INST_GO" "$LATEST_GO"; then
            SEL_2=0
        fi
        if [ "$SEL_3" -eq 1 ] && is_up_to_date "$INST_JDK" "$LATEST_JDK" && ! confirm_reinstall "Eclipse Temurin JDK LTS" "$INST_JDK" "$LATEST_JDK"; then
            SEL_3=0
        fi
        if [ "$SEL_4" -eq 1 ] && is_up_to_date "$INST_NODE" "$LATEST_NODE" && ! confirm_reinstall "Node.js" "$INST_NODE" "$LATEST_NODE"; then
            SEL_4=0
        fi
        if [ "$SEL_5" -eq 1 ] && [[ -n "$INST_PYTHON" && -n "$INST_UV" ]] && ! python_outdated && ! confirm_reinstall "Python & uv" "$INST_PYTHON"; then
            SEL_5=0
        fi
        if [ "$SEL_6" -eq 1 ] && is_up_to_date "$INST_RUST" "$LATEST_RUST" && ! confirm_reinstall "Rust" "$INST_RUST" "$LATEST_RUST"; then
            SEL_6=0
        fi
        if [ "$SEL_7" -eq 1 ] && is_up_to_date "$INST_GCLOUD" "$LATEST_GCLOUD" && ! confirm_reinstall "gcloud CLI" "$INST_GCLOUD" "$LATEST_GCLOUD"; then
            SEL_7=0
        fi
        if [ "$SEL_9" -eq 1 ] && is_up_to_date "$INST_HOMEBREW" "$LATEST_HOMEBREW" && ! confirm_reinstall "Homebrew" "$INST_HOMEBREW" "$LATEST_HOMEBREW"; then
            SEL_9=0
        fi
        if [ "$SEL_10" -eq 1 ] && is_up_to_date "$INST_ORB" "$LATEST_ORB" && ! confirm_reinstall "OrbStack" "$INST_ORB" "$LATEST_ORB"; then
            SEL_10=0
        fi
        if [ "$SEL_11" -eq 1 ] && is_up_to_date "$INST_ANDROID_STUDIO" "$LATEST_ANDROID_STUDIO" && ! confirm_reinstall "Android Studio" "$INST_ANDROID_STUDIO" "$LATEST_ANDROID_STUDIO"; then
            SEL_11=0
        fi
        if [ "$SEL_12" -eq 1 ] && is_up_to_date "$INST_VSCODE" "$LATEST_VSCODE" && ! confirm_reinstall "VSCode" "$INST_VSCODE" "$LATEST_VSCODE"; then
            SEL_12=0
        fi
        if [ "$SEL_13" -eq 1 ] && is_up_to_date "$INST_DBEAVER" "$LATEST_DBEAVER" && ! confirm_reinstall "DBeaver Community Edition" "$INST_DBEAVER" "$LATEST_DBEAVER"; then
            SEL_13=0
        fi
        if [ "$SEL_14" -eq 1 ] && is_up_to_date "$INST_COMPASS" "$LATEST_COMPASS" && ! confirm_reinstall "MongoDB Compass" "$INST_COMPASS" "$LATEST_COMPASS"; then
            SEL_14=0
        fi
        if [ "$SEL_15" -eq 1 ] && is_up_to_date "$INST_ANTIGRAVITY" "$LATEST_ANTIGRAVITY" && ! confirm_reinstall "Antigravity" "$INST_ANTIGRAVITY" "$LATEST_ANTIGRAVITY"; then
            SEL_15=0
        fi
        if [ "$SEL_16" -eq 1 ] && is_up_to_date "$INST_CLAUDE" "$LATEST_CLAUDE" && ! confirm_reinstall "Claude" "$INST_CLAUDE" "$LATEST_CLAUDE"; then
            SEL_16=0
        fi
        if [ "$SEL_17" -eq 1 ] && is_up_to_date "$INST_CODEX" "$LATEST_CODEX" && ! confirm_reinstall "Codex" "$INST_CODEX" "$LATEST_CODEX"; then
            SEL_17=0
        fi
        if [ "$SEL_18" -eq 1 ] && is_up_to_date "$INST_CHROME" "$LATEST_CHROME" && ! confirm_reinstall "Google Chrome" "$INST_CHROME" "$LATEST_CHROME"; then
            SEL_18=0
        fi
        if [ "$SEL_19" -eq 1 ]; then
            if [[ -z "$GLOBAL_PMS" ]]; then
                echo -e "${YELLOW}No supported global package manager found (npm, Homebrew, uv, Bun). Skipping.${NC}"
                SEL_19=0
            elif ! globals_outdated && ! confirm_update_globals; then
                SEL_19=0
            fi
        fi

        # Recount after up-to-date checks
        count=0
        for i in {1..19}; do
            eval "val=\$SEL_$i"
            if [ "$val" -eq 1 ]; then
                count=$((count + 1))
            fi
        done

        if [ "$count" -eq 0 ]; then
            echo -e "\n${YELLOW}No tools to install or update.${NC}"
            if [ "$BATCH_MODE" -eq 1 ]; then
                exit 0
            fi
            echo -e "\nPress Enter to return to menu..."
            read -r || exit 1
            continue
        fi

        # A batch that only updates what is already installed can drop straight
        # back to the menu afterwards. A first-time install prints setup notes
        # (env changes, `gcloud init`, JAVA_HOME, ...) that the menu redraw would
        # wipe, so that case still waits for Enter.
        fresh_install=0
        for i in {1..19}; do
            eval "val=\$SEL_$i"
            if [ "$val" -eq 1 ] && [[ -z "$(installed_version_for "$i")" ]]; then
                fresh_install=1
                break
            fi
        done

        # Check for running GUI apps among remaining selected tools
        WAS_RUNNING_ORB=0
        WAS_RUNNING_ANDROID_STUDIO=0
        WAS_RUNNING_VSCODE=0
        WAS_RUNNING_DBEAVER=0
        WAS_RUNNING_COMPASS=0
        WAS_RUNNING_ANTIGRAVITY=0
        WAS_RUNNING_CLAUDE=0
        WAS_RUNNING_CODEX=0
        WAS_RUNNING_CHROME=0

        running_app_names=()
        running_app_paths=()

        if [ "$SEL_10" -eq 1 ] && is_app_running "/Applications/OrbStack.app"; then
            running_app_names+=("OrbStack")
            running_app_paths+=("/Applications/OrbStack.app")
            WAS_RUNNING_ORB=1
        fi
        if [ "$SEL_11" -eq 1 ] && is_app_running "/Applications/Android Studio.app"; then
            running_app_names+=("Android Studio")
            running_app_paths+=("/Applications/Android Studio.app")
            WAS_RUNNING_ANDROID_STUDIO=1
        fi
        if [ "$SEL_12" -eq 1 ] && is_app_running "/Applications/Visual Studio Code.app"; then
            running_app_names+=("VSCode")
            running_app_paths+=("/Applications/Visual Studio Code.app")
            WAS_RUNNING_VSCODE=1
        fi
        if [ "$SEL_13" -eq 1 ] && is_app_running "/Applications/DBeaver.app"; then
            running_app_names+=("DBeaver")
            running_app_paths+=("/Applications/DBeaver.app")
            WAS_RUNNING_DBEAVER=1
        fi
        if [ "$SEL_14" -eq 1 ] && is_app_running "/Applications/MongoDB Compass.app"; then
            running_app_names+=("MongoDB Compass")
            running_app_paths+=("/Applications/MongoDB Compass.app")
            WAS_RUNNING_COMPASS=1
        fi
        if [ "$SEL_15" -eq 1 ] && is_app_running "/Applications/Antigravity.app"; then
            running_app_names+=("Antigravity")
            running_app_paths+=("/Applications/Antigravity.app")
            WAS_RUNNING_ANTIGRAVITY=1
        fi
        if [ "$SEL_16" -eq 1 ] && is_app_running "/Applications/Claude.app"; then
            running_app_names+=("Claude")
            running_app_paths+=("/Applications/Claude.app")
            WAS_RUNNING_CLAUDE=1
        fi
        if [ "$SEL_17" -eq 1 ] && is_app_running "/Applications/Codex.app"; then
            running_app_names+=("Codex")
            running_app_paths+=("/Applications/Codex.app")
            WAS_RUNNING_CODEX=1
        fi
        if [ "$SEL_18" -eq 1 ] && is_app_running "/Applications/Google Chrome.app"; then
            running_app_names+=("Google Chrome")
            running_app_paths+=("/Applications/Google Chrome.app")
            WAS_RUNNING_CHROME=1
        fi

        if [ ${#running_app_names[@]} -gt 0 ]; then
            echo -e "\n${YELLOW}⚠️  Warning: The following running application(s) need to be closed to proceed with update:${NC}"
            for app_n in "${running_app_names[@]}"; do
                echo -e "${YELLOW}   - ${app_n}${NC}"
            done
            echo -n -e "${YELLOW}Do you want to close them and continue? (y/N): ${NC}"
            read -r response
            if [[ ! "$response" =~ ^[Yy]$ ]]; then
                echo -e "\n${YELLOW}Installation cancelled.${NC}"
                if [ "$BATCH_MODE" -eq 1 ]; then
                    exit 1
                fi
                echo -e "\nPress Enter to return to menu..."
                read -r || exit 1
                continue
            fi

            # User confirmed: kill all running apps
            echo -e "${BLUE}Closing running applications...${NC}"
            for app_p in "${running_app_paths[@]}"; do
                kill_app "$app_p"
            done
        fi

        echo -e "\n${BLUE}Starting installation of $count selected tool(s)...${NC}\n"

        # Keep only the last install: start each batch from an empty log
        : > "$LOG_FILE"

        {
            echo "=================================================="
            echo "Batch installation started: $(date)"
            echo "=================================================="
            
            # 1. Bun
            if [ "$SEL_1" -eq 1 ]; then
                install_bun
                echo ""
            fi
            
            # 2. Go
            if [ "$SEL_2" -eq 1 ]; then
                install_go
                echo ""
            fi
            
            # 3. JDK (Eclipse Temurin LTS)
            if [ "$SEL_3" -eq 1 ]; then
                install_jdk
                echo ""
            fi
            
            # 4. Node.js
            if [ "$SEL_4" -eq 1 ]; then
                install_node "$LATEST_NODE"
                echo ""
            fi
            
            # 5. Python & uv
            if [ "$SEL_5" -eq 1 ]; then
                install_python
                echo ""
            fi
            
            # 6. Rust
            if [ "$SEL_6" -eq 1 ]; then
                install_rust
                echo ""
            fi
            
            # 7. gcloud CLI
            if [ "$SEL_7" -eq 1 ]; then
                install_gcloud
                echo ""
            fi

            # 8. Git
            if [ "$SEL_8" -eq 1 ]; then
                install_git
                echo ""
            fi

            # 9. Homebrew
            if [ "$SEL_9" -eq 1 ]; then
                install_homebrew
                echo ""
            fi

            # 10. OrbStack
            if [ "$SEL_10" -eq 1 ]; then
                install_orb
                echo ""
            fi

            # 11. Android Studio
            if [ "$SEL_11" -eq 1 ]; then
                install_android_studio
                echo ""
            fi

            # 12. VSCode
            if [ "$SEL_12" -eq 1 ]; then
                install_vscode
                echo ""
            fi

            # 13. DBeaver
            if [ "$SEL_13" -eq 1 ]; then
                install_dbeaver
                echo ""
            fi

            # 14. MongoDB Compass
            if [ "$SEL_14" -eq 1 ]; then
                install_compass
                echo ""
            fi

            # 15. Antigravity
            if [ "$SEL_15" -eq 1 ]; then
                install_antigravity
                echo ""
            fi

            # 16. Claude
            if [ "$SEL_16" -eq 1 ]; then
                install_claude
                echo ""
            fi

            # 17. Codex
            if [ "$SEL_17" -eq 1 ]; then
                install_codex
                echo ""
            fi

            # 18. Google Chrome
            if [ "$SEL_18" -eq 1 ]; then
                install_chrome
                echo ""
            fi

            # 19. Global packages (npm, Homebrew, uv, Bun)
            if [ "$SEL_19" -eq 1 ]; then
                update_global_packages
                echo ""
            fi

            echo "=================================================="
            echo "Batch installation finished: $(date)"
            echo "=================================================="
        } 2>&1 | tee -a "$LOG_FILE"
        
        globals_ran=$SEL_19

        # Reset selections after installation
        SEL_1=0; SEL_2=0; SEL_3=0; SEL_4=0; SEL_5=0; SEL_6=0; SEL_7=0; SEL_8=0; SEL_9=0; SEL_10=0; SEL_11=0; SEL_12=0; SEL_13=0; SEL_14=0; SEL_15=0; SEL_16=0; SEL_17=0; SEL_18=0; SEL_19=0
        
        echo -e "${GREEN}Batch installation completed!${NC}"
        echo -e "Logs saved to: ${YELLOW}${LOG_FILE}${NC}"
        echo -e "Please run ${YELLOW}source ~/.zshrc${NC} to load environment changes."
        if [ "$BATCH_MODE" -eq 1 ]; then
            exit 0
        fi
        # Wait only when there is something to read: setup notes from a first
        # install, or a failure the menu redraw would otherwise wipe. A plain
        # update goes straight back to the list.
        if [ "$fresh_install" -eq 1 ] || grep -qE 'Error:|could not be updated' "$LOG_FILE"; then
            echo -e "\nPress Enter to return to the menu..."
            read -r || exit 1
        fi
        refresh_installed_tools
        if [ "$globals_ran" -eq 1 ]; then
            echo -e "${CYAN}Re-checking global packages...${NC}"
            refresh_global_outdated
        fi
    fi
done
