detect_gcloud() {
    # The SDK root carries a VERSION file — reading it avoids paying gcloud's
    # ~1s Python startup on every menu refresh. Fall back to `gcloud --version`
    # (first line: "Google Cloud SDK 577.0.0") for installs we did not place,
    # e.g. a Homebrew-managed one.
    local sdk_root="$HOME/.local/google-cloud-sdk"
    if [[ -r "$sdk_root/VERSION" ]]; then
        head -n1 "$sdk_root/VERSION" | tr -d '[:space:]'
    elif [[ -x "$sdk_root/bin/gcloud" ]]; then
        "$sdk_root/bin/gcloud" --version 2>/dev/null | head -n1 | awk '{print $NF}' || echo ""
    elif command -v gcloud &>/dev/null; then
        gcloud --version 2>/dev/null | head -n1 | awk '{print $NF}' || echo ""
    fi
}

detect_global_pms() {
    # Comma-separated names of the global package managers available here, in
    # GLOBAL_PM_ORDER. Each <pm>_bin resolver applies its own guards (Yarn must
    # be classic, cargo needs cargo-install-update, gem must be non-system).
    local names="" pm
    for pm in $GLOBAL_PM_ORDER; do
        if [[ -n "$(${pm}_bin)" ]]; then
            names+="${names:+, }${pm}"
        fi
    done
    echo "$names"
}

format_status() {
    local installed="$1"
    local latest="$2"
    if [[ -z "$installed" ]]; then
        echo -e "${RED}[Not Installed]${NC}"
    elif [[ -z "$latest" || "$latest" == "Unknown" ]]; then
        echo -e "${GREEN}[Installed: v$installed]${NC} ${YELLOW}(update check failed)${NC}"
    elif [[ "$installed" == "$latest" ]]; then
        echo -e "${GREEN}[Installed: v$installed (Latest)]${NC}"
    elif is_outdated "$installed" "$latest"; then
        echo -e "${YELLOW}[Installed: v$installed -> Upgrade to v$latest]${NC}"
    else
        # Installed is ahead of the version we probed (e.g. a prerelease, or the
        # upstream release landed before the Homebrew/API feed caught up). Never
        # render that as an upgrade — is_outdated would refuse the "upgrade"
        # anyway, and "-> Upgrade to v1.4.0" from v1.4.2 reads as a bug.
        echo -e "${GREEN}[Installed: v$installed (newer than latest v$latest)]${NC}"
    fi
}

format_python_status() {
    local py_inst="$1"
    local uv_inst="$2"
    local py_latest="$3"
    local uv_latest="$4"

    if [[ -z "$py_inst" && -z "$uv_inst" ]]; then
        echo -e "${RED}[Not Installed]${NC}"
        return
    fi

    # Build a per-component fragment: "(Latest)" when current, "-> vX" when an
    # upgrade is available, "(> vX)" when the install is ahead of the version we
    # probed, bare version when the latest couldn't be determined. The ahead case
    # is not "(Latest)" — the numbers on screen would contradict the label.
    local py_frag uv_frag
    if [[ -z "$py_inst" ]]; then
        py_frag="Python3 missing"
    elif [[ -z "$py_latest" || "$py_latest" == "Unknown" ]]; then
        py_frag="Py v$py_inst"
    elif [[ "$py_inst" == "$py_latest" ]]; then
        py_frag="Py v$py_inst (Latest)"
    elif ! is_outdated "$py_inst" "$py_latest"; then
        py_frag="Py v$py_inst (> v$py_latest)"
    else
        py_frag="Py v$py_inst -> v$py_latest"
    fi
    if [[ -z "$uv_inst" ]]; then
        uv_frag="uv missing"
    elif [[ -z "$uv_latest" || "$uv_latest" == "Unknown" ]]; then
        uv_frag="uv v$uv_inst"
    elif [[ "$uv_inst" == "$uv_latest" ]]; then
        uv_frag="uv v$uv_inst (Latest)"
    elif ! is_outdated "$uv_inst" "$uv_latest"; then
        uv_frag="uv v$uv_inst (> v$uv_latest)"
    else
        uv_frag="uv v$uv_inst -> v$uv_latest"
    fi

    # Yellow whenever something is missing or outdated, green only when both are current.
    local color="$GREEN"
    if [[ -z "$py_inst" || -z "$uv_inst" ]] \
        || is_outdated "$py_inst" "$py_latest" \
        || is_outdated "$uv_inst" "$uv_latest"; then
        color="$YELLOW"
    fi

    echo -e "${color}[Installed: ${py_frag} | ${uv_frag}]${NC}"
}

format_git_status() {
    local installed="$1"
    if [[ -z "$installed" ]]; then
        echo -e "${RED}[Not Installed]${NC}"
    else
        echo -e "${GREEN}[Installed: v$installed (System Managed)]${NC}"
    fi
}

format_globals_status() {
    local pms="$1" npm_n="$2" brew_n="$3"

    if [[ -z "$pms" ]]; then
        echo -e "${RED}[Not Installed]${NC}"
        return
    fi

    # Only npm and Homebrew are cheap to poll at startup, so they carry the
    # headline count. The rest are updated on demand (press Enter on this row for
    # a full per-manager breakdown), so the status names how many managers are
    # available rather than pretending to know every one is current. An empty
    # npm/brew count means that check failed — a manager with nothing outdated
    # reports 0.
    local n_mgr unit
    n_mgr=$(awk -F', ' '{print NF}' <<< "$pms")
    unit="managers"; [[ "$n_mgr" -eq 1 ]] && unit="manager"

    local frags=""
    [[ "$npm_n" =~ ^[1-9][0-9]*$ ]] && frags+="npm ${npm_n}"
    [[ "$brew_n" =~ ^[1-9][0-9]*$ ]] && frags+="${frags:+, }brew ${brew_n}"

    if [[ -n "$frags" ]]; then
        echo -e "${YELLOW}[${n_mgr} ${unit}, outdated: ${frags}]${NC} ${CYAN}(Enter for details)${NC}"
    elif [[ -z "$npm_n" || -z "$brew_n" ]]; then
        # Never claim "current" on the strength of a check that did not run.
        echo -e "${GREEN}[${n_mgr} ${unit}]${NC} ${YELLOW}(update check failed)${NC} ${CYAN}(Enter for details)${NC}"
    else
        echo -e "${GREEN}[${n_mgr} ${unit} ready]${NC} ${CYAN}(Enter for details)${NC}"
    fi
}

show_checkbox() {
    local val="$1"
    if [ "$val" -eq 1 ]; then
        echo -e "[${GREEN}✓${NC}]"
    else
        echo -e "[ ]"
    fi
}

show_line() {
    local line_num="$1"
    local content="$2"
    if [ "$CURSOR" -eq "$line_num" ]; then
        local hl_content
        hl_content=$(echo -e "$content" | sed "s/\x1b\[0m/\x1b\[0m\x1b\[1;36m/g")
        echo -e "${CYAN}❯ \033[1;36m${hl_content}${NC}\033[K"
    else
        echo -e "  $content\033[K"
    fi
}

show_action_item() {
    local line_num="$1"
    local text="$2"
    if [ "$CURSOR" -eq "$line_num" ]; then
        echo -n -e "${CYAN}❯ \033[1;36m${text}${NC}"
    else
        echo -n -e "  ${text}"
    fi
}

update_env_block() {
    local marker="$1"
    local content="$2"
    local env_file="$HOME/.zsh/setup-zsh/env.zsh"
    
    mkdir -p "$(dirname "$env_file")"
    touch "$env_file"
    
    local temp_file
    temp_file=$(mktemp /tmp/env_zsh.XXXXXX)
    awk -v start="# >>> ${marker} >>>" -v end="# <<< ${marker} <<<" '
        $0 == start {p=1; next}
        $0 == end {p=0; next}
        !p
    ' "$env_file" > "$temp_file"
    
    if [[ -n "$content" ]]; then
        echo -e "# >>> ${marker} >>>\n${content}\n# <<< ${marker} <<<" >> "$temp_file"
    fi
    
    mv "$temp_file" "$env_file"
}

is_outdated() {
    # is_outdated <installed> <latest> — true only when latest is known and
    # strictly newer than installed. An installed version that is ahead of the
    # reported latest (e.g. upstream released before the Homebrew formula API
    # caught up) is NOT outdated, so we never suggest a downgrade.
    [ -n "$1" ] && [ -n "$2" ] && [ "$2" != "Unknown" ] && [ "$1" != "$2" ] || return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]
}

is_up_to_date() {
    # is_up_to_date <installed> <latest> — true when the tool is installed, the
    # latest version is known, and it is not outdated. Deliberately the inverse of
    # is_outdated *plus* those two preconditions: a missing install or a failed
    # version probe is not "up to date", and an install ahead of latest is.
    [ -n "$1" ] && [ -n "$2" ] && [ "$2" != "Unknown" ] || return 1
    ! is_outdated "$1" "$2"
}

require_latest() {
    local name="$1" ver="$2"
    if [[ -z "$ver" || "$ver" == "Unknown" ]]; then
        echo -e "${RED}Error: Could not determine the latest ${name} version (network issue?). Skipping.${NC}"
        return 1
    fi
    return 0
}

confirm_reinstall() {
    # confirm_reinstall <name> <installed> [latest] — asked before re-installing a
    # tool that is_outdated says needs nothing. With <latest> given and behind the
    # installed version, the "re-install" would actually put an older build on
    # disk (installers always fetch $LATEST_*), so ask for a downgrade explicitly.
    local name="$1"
    local version="$2"
    local latest="$3"
    if [[ -n "$latest" && "$latest" != "Unknown" && "$latest" != "$version" ]]; then
        echo -n -e "${YELLOW}${name} v${version} is newer than the latest release we found (v${latest}). Re-install and downgrade? (y/N): ${NC}"
    else
        echo -n -e "${YELLOW}${name} is already up-to-date (v${version}). Re-install? (y/N): ${NC}"
    fi
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        return 0
    else
        return 1
    fi
}

confirm_update_globals() {
    echo -n -e "${YELLOW}Global packages are already up-to-date. Run the updaters anyway? (y/N): ${NC}"
    read -r response
    if [[ "$response" =~ ^[Yy]$ ]]; then
        return 0
    else
        return 1
    fi
}

is_app_running() {
    local app_path="$1"
    if [[ -d "$app_path" ]]; then
        pgrep -f "$app_path" &>/dev/null
        return $?
    fi
    return 1
}

kill_app() {
    local app_path="$1"
    if pgrep -f "$app_path" &>/dev/null; then
        pkill -f "$app_path" 2>/dev/null || true
        sleep 1
        if pgrep -f "$app_path" &>/dev/null; then
            pkill -9 -f "$app_path" 2>/dev/null || true
        fi
    fi
}

reopen_app_if_was_running() {
    local app_name="$1"
    local app_path="$2"
    local was_running="$3"
    if [[ "$was_running" -eq 1 && -d "$app_path" ]]; then
        echo -e "${BLUE}Reopening ${app_name}...${NC}"
        open "$app_path" 2>/dev/null || true
    fi
}

install_app_bundle() {
    # Stage the new bundle first so a failed copy never leaves the app deleted
    local src="$1"    # path to the new X.app
    local name="$2"   # bundle name in /Applications, e.g. "OrbStack.app"
    local staging="/Applications/.${name}.staging"
    rm -rf "$staging"
    if ! ditto "$src" "$staging"; then
        rm -rf "$staging"
        return 1
    fi
    rm -rf "/Applications/${name}"
    mv "$staging" "/Applications/${name}"
}

install_bun() {
    echo -e "${BLUE}Installing Bun v${LATEST_BUN}...${NC}"
    if ! curl -fsSL https://bun.sh/install | bash; then
        echo -e "${RED}Error: Failed to install Bun.${NC}"
        return 1
    fi
    
    echo "Updating env.zsh..."
    local content="export BUN_INSTALL=\"\$HOME/.bun\"\nexport PATH=\"\$BUN_INSTALL/bin:\$PATH\""
    update_env_block "Bun" "$content"
    
    echo -e "${GREEN}✓ Bun v${LATEST_BUN} installed successfully!${NC}"
}

install_go() {
    require_latest "Go" "$LATEST_GO" || return 1
    echo -e "${BLUE}Installing Go v${LATEST_GO}...${NC}"
    local download_url="https://dl.google.com/go/go${LATEST_GO}.darwin-${GO_ARCH}.tar.gz"
    # No file extension: BSD mktemp (macOS) only substitutes TRAILING Xs, so a
    # "go.XXXXXX.tar.gz" template is taken literally (no randomization) and would
    # collide on reruns. tar/unzip/hdiutil read magic bytes, so the suffix is moot.
    local temp_tar=$(mktemp /tmp/go.XXXXXX)
    
    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_tar"; then
        echo -e "${RED}Error: Failed to download Go.${NC}"
        return 1
    fi
    
    echo "Extracting to ~/.local/go..."
    mkdir -p "$HOME/.local"
    rm -rf "$HOME/.local/go"
    if ! tar -xzf "$temp_tar" -C "$HOME/.local"; then
        echo -e "${RED}Error: Failed to extract Go.${NC}"
        rm -f "$temp_tar"
        return 1
    fi
    
    rm -f "$temp_tar"
    
    echo "Updating env.zsh..."
    local content="export GOROOT=\"\$HOME/.local/go\"\nexport GOPATH=\"\$HOME/go\"\nexport PATH=\"\$GOROOT/bin:\$GOPATH/bin:\$PATH\""
    update_env_block "Go" "$content"
    
    echo -e "${GREEN}✓ Go v${LATEST_GO} installed successfully!${NC}"
}

preserve_node_globals() {
    # Carry user-installed global npm packages (and their bin launchers) from an
    # existing Node.js tree into a freshly extracted one so an upgrade does not
    # lose them. Globals live in lib/node_modules/<pkg> with launcher symlinks in
    # bin/; the bundled npm/corepack are left as shipped by the new version.
    # Exact versions are preserved (no re-download), so this also works offline.
    local old_root="$1" new_root="$2"
    local old_mods="$old_root/lib/node_modules"
    local new_mods="$new_root/lib/node_modules"
    [[ -d "$old_mods" ]] || return 0
    mkdir -p "$new_mods"

    local entry name sub
    for entry in "$old_mods"/*; do
        [[ -e "$entry" ]] || continue
        name=$(basename "$entry")
        case "$name" in
            npm|corepack|.bin) continue ;;
        esac
        if [[ "$name" == @* ]]; then
            # Scoped packages: preserve each @scope/<pkg> individually so the new
            # tree keeps every scoped global (e.g. @angular/cli).
            mkdir -p "$new_mods/$name"
            for sub in "$entry"/*; do
                [[ -e "$sub" ]] || continue
                rm -rf "$new_mods/$name/$(basename "$sub")"
                cp -R "$sub" "$new_mods/$name/" 2>/dev/null || true
            done
        else
            rm -rf "$new_mods/$name"
            cp -R "$entry" "$new_mods/" 2>/dev/null || true
        fi
    done

    # Recreate the bin/ launcher symlinks for the carried-over packages, leaving
    # the new Node's own launchers (node/npm/npx/corepack) untouched. The links
    # are relative (e.g. ../lib/node_modules/<pkg>/bin/cli.js), so they resolve
    # correctly once the tree lands at its final ~/.local/node location.
    local bin binname target
    for bin in "$old_root/bin"/*; do
        [[ -L "$bin" ]] || continue
        binname=$(basename "$bin")
        case "$binname" in
            node|npm|npx|corepack) continue ;;
        esac
        [[ -e "$new_root/bin/$binname" || -L "$new_root/bin/$binname" ]] && continue
        target=$(readlink "$bin")
        ln -s "$target" "$new_root/bin/$binname" 2>/dev/null || true
    done
}

install_node() {
    local version="$1"
    require_latest "Node.js" "$version" || return 1
    echo -e "${BLUE}Installing Node.js v${version}...${NC}"
    local download_url="https://nodejs.org/dist/v${version}/node-v${version}-darwin-${NODE_ARCH}.tar.gz"
    local temp_tar=$(mktemp /tmp/node.XXXXXX)

    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_tar"; then
        echo -e "${RED}Error: Failed to download Node.js.${NC}"
        return 1
    fi

    echo "Extracting Node.js..."
    local temp_extract_dir
    temp_extract_dir=$(mktemp -d /tmp/node_extract.XXXXXX)
    if ! tar -xzf "$temp_tar" -C "$temp_extract_dir"; then
        echo -e "${RED}Error: Failed to extract Node.js.${NC}"
        rm -f "$temp_tar"
        rm -rf "$temp_extract_dir"
        return 1
    fi
    local new_node="$temp_extract_dir/node-v${version}-darwin-${NODE_ARCH}"

    # Preserve globally-installed npm packages before replacing the old tree, so
    # upgrading Node.js never wipes them (previously `rm -rf ~/.local/node` did).
    local preserved_globals=0
    if [[ -d "$HOME/.local/node/lib/node_modules" ]]; then
        echo "Preserving global npm packages..."
        preserve_node_globals "$HOME/.local/node" "$new_node"
        preserved_globals=1
    fi

    echo "Installing to ~/.local/node..."
    mkdir -p "$HOME/.local"
    rm -rf "$HOME/.local/node"
    if ! mv "$new_node" "$HOME/.local/node"; then
        echo -e "${RED}Error: Failed to move Node.js into ~/.local/node.${NC}"
        rm -f "$temp_tar"
        rm -rf "$temp_extract_dir"
        return 1
    fi

    rm -f "$temp_tar"
    rm -rf "$temp_extract_dir"

    echo "Updating env.zsh..."
    local content="export PATH=\"\$HOME/.local/node/bin:\$PATH\""
    update_env_block "Node" "$content"

    # Rebuild the carried-over globals against the new Node ABI so packages with
    # native addons keep working across a major version bump. Pure-JS packages
    # are a fast no-op. Best-effort: problems here do not fail the install, and
    # npm is invoked from the new tree so its global prefix is ~/.local/node.
    if [[ "$preserved_globals" -eq 1 && -x "$HOME/.local/node/bin/npm" ]]; then
        echo "Rebuilding global npm packages for the new Node.js version..."
        if ! PATH="$HOME/.local/node/bin:$PATH" "$HOME/.local/node/bin/npm" rebuild -g; then
            echo -e "${YELLOW}Warning: 'npm rebuild -g' reported problems. If a global tool with native addons misbehaves, reinstall it with 'npm install -g <pkg>'.${NC}"
        fi
    fi

    echo -e "${GREEN}✓ Node.js v${version} installed successfully!${NC}"
    echo -e "${YELLOW}Note: Global npm packages will be installed under ~/.local/node without requiring sudo!${NC}"
}

install_orb() {
    echo -e "${BLUE}Installing OrbStack v${LATEST_ORB}...${NC}"
    local download_url
    download_url=$(curl -s --max-time 10 "https://cdn-updates.orbstack.dev/${ORB_ARCH}/appcast.new.xml" | grep -o 'enclosure url="[^"]*"' | head -n 1 | cut -d'"' -f2 || echo "")
    if [[ -z "$download_url" ]]; then
        echo -e "${RED}Error: Failed to resolve OrbStack download URL.${NC}"
        return 1
    fi
    
    local temp_dmg=$(mktemp /tmp/orbstack.XXXXXX)
    
    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_dmg"; then
        echo -e "${RED}Error: Failed to download OrbStack.${NC}"
        return 1
    fi
    
    echo "Mounting DMG..."
    local mount_point="/Volumes/OrbStack_temp_$$"
    mkdir -p "$mount_point"
    if ! hdiutil attach -nobrowse -readonly -mountpoint "$mount_point" "$temp_dmg"; then
        echo -e "${RED}Error: Failed to mount OrbStack DMG.${NC}"
        rm -f "$temp_dmg"
        rm -rf "$mount_point"
        return 1
    fi
    
    echo "Copying to Applications..."
    if ! install_app_bundle "${mount_point}/OrbStack.app" "OrbStack.app"; then
        echo -e "${RED}Error: Failed to copy OrbStack to /Applications.${NC}"
        hdiutil detach "$mount_point"
        rm -f "$temp_dmg"
        rm -rf "$mount_point"
        return 1
    fi
    
    echo "Unmounting DMG..."
    hdiutil detach "$mount_point"
    rm -rf "$mount_point"
    rm -f "$temp_dmg"
    
    echo "Updating env.zsh..."
    local content="if [[ -d \"/Applications/OrbStack.app/Contents/MacOS/bin\" ]]; then\n  export PATH=\"/Applications/OrbStack.app/Contents/MacOS/bin:\$PATH\"\nfi"
    update_env_block "OrbStack" "$content"
    
    echo -e "${GREEN}✓ OrbStack v${LATEST_ORB} installed to /Applications/OrbStack.app!${NC}"
    if [[ "$WAS_RUNNING_ORB" -eq 1 ]]; then
        reopen_app_if_was_running "OrbStack" "/Applications/OrbStack.app" "$WAS_RUNNING_ORB"
    else
        echo -e "${YELLOW}Please launch OrbStack to complete system setup: open -a OrbStack${NC}"
    fi
}

install_vscode() {
    echo -e "${BLUE}Installing VSCode v${LATEST_VSCODE}...${NC}"
    local download_url="https://update.code.visualstudio.com/latest/darwin-universal/stable"
    local temp_zip=$(mktemp /tmp/vscode.XXXXXX)
    
    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_zip"; then
        echo -e "${RED}Error: Failed to download VSCode.${NC}"
        return 1
    fi
    
    echo "Extracting..."
    local temp_extract_dir
    temp_extract_dir=$(mktemp -d /tmp/vscode_extract.XXXXXX)
    if ! unzip -q "$temp_zip" -d "$temp_extract_dir"; then
        echo -e "${RED}Error: Failed to extract VSCode.${NC}"
        rm -f "$temp_zip"
        rm -rf "$temp_extract_dir"
        return 1
    fi
    
    echo "Moving to Applications..."
    if ! install_app_bundle "$temp_extract_dir/Visual Studio Code.app" "Visual Studio Code.app"; then
        echo -e "${RED}Error: Failed to copy VSCode to /Applications.${NC}"
        rm -f "$temp_zip"
        rm -rf "$temp_extract_dir"
        return 1
    fi
    
    rm -f "$temp_zip"
    rm -rf "$temp_extract_dir"
    
    echo "Updating env.zsh..."
    local content="export PATH=\"/Applications/Visual Studio Code.app/Contents/Resources/app/bin:\$PATH\""
    update_env_block "VSCode" "$content"
    
    echo -e "${GREEN}✓ VSCode v${LATEST_VSCODE} installed to /Applications/Visual Studio Code.app!${NC}"
    reopen_app_if_was_running "VSCode" "/Applications/Visual Studio Code.app" "$WAS_RUNNING_VSCODE"
}

install_python() {
    # Decide per component what actually needs installing. Python and uv version
    # independently, so a uv bump must not drag the whole Python pkg (and its sudo
    # prompt) along. When the pair is already current we only reach here via an
    # explicit re-install confirmation, so refresh both; otherwise touch only
    # what is missing or outdated.
    local need_python=0 need_uv=0
    if python_outdated; then
        { [[ -z "$INST_PYTHON" ]] || is_outdated "$INST_PYTHON" "$LATEST_PYTHON"; } && need_python=1
        { [[ -z "$INST_UV" ]] || is_outdated "$INST_UV" "$LATEST_UV"; } && need_uv=1
    else
        need_python=1
        need_uv=1
    fi

    if [[ "$need_python" -eq 1 ]]; then
        require_latest "Python" "$LATEST_PYTHON" || return 1
        echo -e "${BLUE}Installing Python v${LATEST_PYTHON}...${NC}"
        local download_url="https://www.python.org/ftp/python/${LATEST_PYTHON}/python-${LATEST_PYTHON}-macos11.pkg"
        # installer(8) requires a .pkg extension, and BSD mktemp only substitutes
        # trailing Xs; make a randomized temp file, then give it the .pkg suffix.
        local temp_pkg=$(mktemp /tmp/python.XXXXXX)
        mv "$temp_pkg" "$temp_pkg.pkg"
        temp_pkg="$temp_pkg.pkg"

        echo "Downloading ${download_url}..."
        if ! curl -fL --progress-bar "$download_url" -o "$temp_pkg"; then
            echo -e "${RED}Error: Failed to download Python.${NC}"
            return 1
        fi

        echo -e "${YELLOW}This installation requires administrator privileges. Please enter your password when prompted.${NC}"
        if ! sudo installer -pkg "$temp_pkg" -target /; then
            echo -e "${RED}Error: Failed to install Python pkg.${NC}"
            rm -f "$temp_pkg"
            return 1
        fi

        rm -f "$temp_pkg"
    else
        echo -e "${GREEN}Python v${INST_PYTHON} is already up-to-date. Skipping.${NC}"
    fi

    if [[ "$need_uv" -eq 1 ]]; then
        echo -e "${BLUE}Installing uv (Python package installer v${LATEST_UV})...${NC}"
        mkdir -p "$HOME/.local/bin"
        if ! curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="$HOME/.local/bin" sh; then
            echo -e "${YELLOW}Warning: Failed to install uv via installer script, attempting fallback...${NC}"
            local uv_arch="aarch64"
            if [ "$ARCH" = "x86_64" ]; then
                uv_arch="x86_64"
            fi
            local uv_url="https://github.com/astral-sh/uv/releases/download/${LATEST_UV}/uv-${uv_arch}-apple-darwin.tar.gz"
            local temp_uv_tar=$(mktemp /tmp/uv.XXXXXX)
            if curl -fL --progress-bar "$uv_url" -o "$temp_uv_tar"; then
                local temp_uv_extract=$(mktemp -d /tmp/uv_extract.XXXXXX)
                tar -xzf "$temp_uv_tar" -C "$temp_uv_extract"
                mv "$temp_uv_extract"/uv-${uv_arch}-apple-darwin/uv* "$HOME/.local/bin/" 2>/dev/null || true
                rm -rf "$temp_uv_tar" "$temp_uv_extract"
            fi
        fi
    else
        echo -e "${GREEN}uv v${INST_UV} is already up-to-date. Skipping.${NC}"
    fi

    echo "Updating env.zsh..."
    local content="export PATH=\"\$HOME/.local/bin:\$PATH\"\nalias python=\"python3\"\nalias pip=\"pip3\""
    update_env_block "Python" "$content"

    if [[ "$need_python" -eq 1 && "$need_uv" -eq 1 ]]; then
        echo -e "${GREEN}✓ Python v${LATEST_PYTHON} and uv v${LATEST_UV} installed successfully!${NC}"
    elif [[ "$need_python" -eq 1 ]]; then
        echo -e "${GREEN}✓ Python v${LATEST_PYTHON} installed successfully!${NC}"
    else
        echo -e "${GREEN}✓ uv v${LATEST_UV} installed successfully!${NC}"
    fi
}

install_jdk() {
    echo -e "${BLUE}Installing Eclipse Temurin JDK LTS v${LATEST_JDK}...${NC}"
    local lts_ver
    lts_ver=$(echo "$LATEST_JDK" | cut -d. -f1)
    [[ -z "$lts_ver" ]] && lts_ver="21"
    local download_url
    download_url=$(curl -s --max-time 10 "https://api.adoptium.net/v3/assets/feature_releases/${lts_ver}/ga?architecture=${JDK_ARCH}&image_type=jdk&os=mac&vendor=eclipse" | grep -o 'https://github.com/adoptium/temurin[0-9]*-binaries/releases/download/[^"]*\.pkg' | head -n 1 || echo "")
    if [[ -z "$download_url" ]]; then
        echo -e "${RED}Error: Failed to resolve Temurin JDK download URL.${NC}"
        return 1
    fi
    # installer(8) requires a .pkg extension, and BSD mktemp only substitutes
    # trailing Xs; make a randomized temp file, then give it the .pkg suffix.
    local temp_pkg=$(mktemp /tmp/jdk.XXXXXX)
    mv "$temp_pkg" "$temp_pkg.pkg"
    temp_pkg="$temp_pkg.pkg"

    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_pkg"; then
        echo -e "${RED}Error: Failed to download Temurin JDK.${NC}"
        return 1
    fi
    
    echo -e "${YELLOW}This installation requires administrator privileges. Please enter your password when prompted.${NC}"
    if ! sudo installer -pkg "$temp_pkg" -target /; then
        echo -e "${RED}Error: Failed to install Temurin JDK pkg.${NC}"
        rm -f "$temp_pkg"
        return 1
    fi
    
    rm -f "$temp_pkg"
    
    echo "Updating env.zsh..."
    local content="if command -v /usr/libexec/java_home &>/dev/null; then\n  export JAVA_HOME=\"\$(/usr/libexec/java_home 2>/dev/null)\"\n  export PATH=\"\$JAVA_HOME/bin:\$PATH\"\nfi"
    update_env_block "JDK" "$content"
    
    echo -e "${GREEN}✓ Eclipse Temurin JDK LTS v${LATEST_JDK} installed successfully!${NC}"
}

