#!/bin/bash

# setup-zsh Developer Tool Installer
# Installs and updates Bun, Go, Homebrew, JDK (Eclipse Temurin LTS), Node.js, Python & uv, Rust, gcloud CLI, Git, OrbStack, Android Studio, VSCode, DBeaver, MongoDB Compass, Antigravity, Claude, and Google Chrome on macOS.
# Also updates the packages installed *through* those tools: global packages of npm, pnpm, Yarn (classic), Bun, Homebrew, uv, pipx, RubyGems, Composer, and cargo (via cargo-install-update).

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
PURPLE='\033[0;35m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Detect architecture
ARCH=$(uname -m)
if [ "$ARCH" = "x86_64" ]; then
    GO_ARCH="amd64"
    NODE_ARCH="x64"
    ORB_ARCH="amd64"
    DBEAVER_ARCH="x86_64"
    JDK_ARCH="x64"
    GCLOUD_ARCH="x86_64"
else
    GO_ARCH="arm64"
    NODE_ARCH="arm64"
    ORB_ARCH="arm64"
    DBEAVER_ARCH="aarch64"
    JDK_ARCH="aarch64"
    GCLOUD_ARCH="arm"
fi

usage() {
    echo "Usage: install-dev-tool [OPTION]"
    echo ""
    echo "  (no option)        open the interactive menu"
    echo "  -u, --update-all   select and update every outdated tool, then exit"
    echo "  -a, --all          select all tools (asks before re-installing up-to-date ones), then exit"
    echo "  -h, --help         show this help"
}

# Handle --help/unknown flags before the (network-bound) version checks
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    ""|-u|--update-all|update-all|-a|--all) : ;;
    *) echo "Unknown option: ${1}"; usage; exit 1 ;;
esac

LOG_DIR="$HOME/.zsh/setup-zsh"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/install.log"

log_msg() {
    echo "[$(date +'%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"
}
trap 'log_msg "Shell error on line $LINENO (command: $BASH_COMMAND)"' ERR

cleanup_on_exit() {
    printf "\033[?25h"
    kill $(jobs -p) 2>/dev/null
    [ -n "${TEMP_VER_DIR:-}" ] && rm -rf "$TEMP_VER_DIR"
}
trap cleanup_on_exit EXIT
# INT/TERM must actually exit: a bare cleanup trap would swallow Ctrl+C
# (bash runs the handler and restarts the interrupted read)
trap 'exit 130' INT TERM

# ---- Global package managers ------------------------------------------------
# Resolve each manager the way its detect_* counterpart does: prefer the copy
# this installer places under $HOME, so updates target the tool we manage, and
# fall back to whatever is on PATH.
npm_bin() {
    if [[ -x "$HOME/.local/node/bin/npm" ]]; then
        echo "$HOME/.local/node/bin/npm"
    elif command -v npm &>/dev/null; then
        command -v npm
    fi
}

brew_bin() {
    if [[ -x "/opt/homebrew/bin/brew" ]]; then
        echo "/opt/homebrew/bin/brew"
    elif [[ -x "/usr/local/bin/brew" ]]; then
        echo "/usr/local/bin/brew"
    elif command -v brew &>/dev/null; then
        command -v brew
    fi
}

uv_bin() {
    if [[ -x "$HOME/.local/bin/uv" ]]; then
        echo "$HOME/.local/bin/uv"
    elif command -v uv &>/dev/null; then
        command -v uv
    fi
}

bun_bin() {
    if [[ -x "$HOME/.bun/bin/bun" ]]; then
        echo "$HOME/.bun/bin/bun"
    elif command -v bun &>/dev/null; then
        command -v bun
    fi
}

# The managers this row can update, in the order they are shown and run. A
# manager appears only when its <pm>_bin resolver returns a usable path.
GLOBAL_PM_ORDER="npm pnpm yarn bun brew uv pipx gem composer cargo"

pnpm_home() {
    # pnpm keeps its global packages under $PNPM_HOME (default ~/Library/pnpm on
    # macOS) and refuses to touch globals unless that dir is on PATH.
    echo "${PNPM_HOME:-$HOME/Library/pnpm}"
}

pnpm_bin() {
    if [[ -x "$HOME/.local/node/bin/pnpm" ]]; then
        echo "$HOME/.local/node/bin/pnpm"
    elif command -v pnpm &>/dev/null; then
        command -v pnpm
    fi
}

yarn_bin() {
    local y=""
    if [[ -x "$HOME/.local/node/bin/yarn" ]]; then
        y="$HOME/.local/node/bin/yarn"
    elif command -v yarn &>/dev/null; then
        y="$(command -v yarn)"
    fi
    [[ -n "$y" ]] || return 0
    # Only Yarn Classic (1.x) has `yarn global`; Berry (2+) removed it entirely,
    # so a modern Yarn has no global packages for us to manage.
    case "$("$y" --version 2>/dev/null)" in
        1.*) echo "$y" ;;
    esac
}

pipx_bin() {
    if [[ -x "$HOME/.local/bin/pipx" ]]; then
        echo "$HOME/.local/bin/pipx"
    elif command -v pipx &>/dev/null; then
        command -v pipx
    fi
}

gem_bin() {
    local g
    g="$(command -v gem 2>/dev/null)" || return 0
    [[ -n "$g" ]] || return 0
    # Skip Apple's system Ruby: `gem update` there wants sudo and can damage the
    # OS-managed gemset. Only manage a user-writable Ruby (Homebrew, rbenv, ...).
    case "$g" in
        /usr/bin/*|/System/*) return 0 ;;
    esac
    echo "$g"
}

composer_bin() {
    command -v composer 2>/dev/null || true
}

cargo_bin() {
    # cargo installs global binaries but cannot upgrade them on its own; that
    # needs the cargo-update plugin (`cargo install-update`). Advertise cargo as
    # a manager only when the plugin is present, so we never offer an update we
    # cannot perform.
    if [[ ! -x "$HOME/.cargo/bin/cargo-install-update" ]] && ! command -v cargo-install-update &>/dev/null; then
        return 0
    fi
    if [[ -x "$HOME/.cargo/bin/cargo" ]]; then
        echo "$HOME/.cargo/bin/cargo"
    elif command -v cargo &>/dev/null; then
        command -v cargo
    fi
}

# Run a JS package manager with its global bin dir on PATH so global installs
# resolve to the right prefix. pnpm additionally needs PNPM_HOME exported.
run_js_pm() {
    local bin="$1"; shift
    local dir; dir="$(dirname "$bin")"
    case "$bin" in
        *pnpm) env PNPM_HOME="$(pnpm_home)" PATH="$(pnpm_home):$(pnpm_home)/bin:$dir:$PATH" "$bin" "$@" ;;
        *) PATH="$dir:$PATH" "$bin" "$@" ;;
    esac
}

npm_outdated_list() {
    # Prints "<pkg>@<latest>" for every outdated global package.
    # `npm outdated -g --parseable` emits
    #   <path>:<pkg>@<wanted>:<pkg>@<current>:<pkg>@<latest>:global
    # so field 4 is what we want. npm exits 1 whenever anything is outdated, so
    # its exit status carries no error signal here.
    # npm and corepack are skipped deliberately: they ship inside the Node.js
    # tarball, so install_node owns their versions (preserve_node_globals skips
    # them for the same reason) and an update here would be undone by the next
    # Node.js upgrade.
    local npm
    npm=$(npm_bin)
    [[ -n "$npm" ]] || return 0
    # The fetch flags bound the registry round-trip. npm's own defaults are a
    # 5-minute timeout with retries, which would leave the startup spinner
    # hanging whenever the registry is unreachable.
    "$npm" outdated -g --parseable --fetch-timeout=10000 --fetch-retries=0 2>/dev/null \
        | cut -d: -f4 \
        | grep -v -e '^npm@' -e '^corepack@'
}

brew_outdated_count() {
    local brew
    brew=$(brew_bin)
    if [[ -z "$brew" ]]; then
        echo 0
        return
    fi
    # HOMEBREW_NO_AUTO_UPDATE keeps the menu fast and offline: the count comes
    # from metadata brew already has on disk (so there is no network call to
    # time out), and a real `brew update` runs as part of the upgrade itself.
    # No --greedy, so the count matches what the upgrade will actually touch
    # (casks that ship their own updater are excluded).
    env HOMEBREW_NO_AUTO_UPDATE=1 "$brew" outdated --quiet 2>/dev/null | wc -l | tr -d ' '
}

spawn_global_checks() {
    local dir="$1"
    ( npm_outdated_list | wc -l | tr -d ' ' > "$dir/npm_outdated" ) &
    ( brew_outdated_count > "$dir/brew_outdated" ) &
}

read_global_checks() {
    local dir="$1"
    OUTDATED_NPM=$(cat "$dir/npm_outdated" 2>/dev/null)
    OUTDATED_BREW=$(cat "$dir/brew_outdated" 2>/dev/null)
    # A killed or failed check leaves something that is not a number — keep that
    # as "unknown" so it can never be mistaken for "nothing to update".
    [[ "$OUTDATED_NPM" =~ ^[0-9]+$ ]] || OUTDATED_NPM=""
    [[ "$OUTDATED_BREW" =~ ^[0-9]+$ ]] || OUTDATED_BREW=""
}

refresh_global_outdated() {
    local dir
    dir=$(mktemp -d /tmp/setup-zsh-globals.XXXXXX)
    spawn_global_checks "$dir"
    wait
    read_global_checks "$dir"
    rm -rf "$dir"
}

TEMP_VER_DIR=$(mktemp -d /tmp/setup-zsh-versions.XXXXXX)

# Launch parallel version checks in the background (Git is system-managed, so no check needed)
(
    LATEST=$(curl -s --max-time 10 'https://go.dev/VERSION?m=text' | head -n1 | sed 's/^go//' || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/go"
) &

(
    LATEST=$(curl -s --max-time 10 https://nodejs.org/dist/index.tab | awk 'NR==2 {print $1}' | sed 's/^v//' || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/node"
) &

(
    LATEST=$(curl -s --max-time 10 "https://cdn-updates.orbstack.dev/${ORB_ARCH}/appcast.new.xml" | grep -o '<sparkle:shortVersionString>[^<]*' | head -n 1 | sed 's/<sparkle:shortVersionString>//' || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/orb"
) &

(
    LATEST=$(curl -s --max-time 10 "https://update.code.visualstudio.com/api/update/darwin-universal/stable/latest" | grep -o '"name":"[^"]*"' | head -n 1 | cut -d'"' -f4 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/vscode"
) &

(
    LATEST=$(curl -s --max-time 10 -L --compressed https://www.python.org/downloads/macos/ | grep -o 'https://www.python.org/ftp/python/[0-9.]*/python-[0-9.]*-macos11.pkg' | sort -V | tail -n 1 | cut -d/ -f6 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/python"
) &

(
    # install_uv downloads the GitHub release tagged $LATEST_UV, so read the tag
    # list itself rather than the brew formula — sourcing "latest" from a
    # different place than we download from can only ever disagree. The tags are
    # bare versions (0.12.10), exactly the string the download URL needs.
    LATEST=$(curl -s --max-time 10 https://github.com/astral-sh/uv/releases.atom | grep -o 'releases/tag/[0-9][^"<]*' | head -n 1 | sed 's#releases/tag/##')
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/formula/uv.json | grep -o '"stable":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/uv"
) &

(
    LTS_VER=$(curl -s --max-time 10 "https://api.adoptium.net/v3/info/available_releases" | grep -o '"most_recent_lts": [0-9]*' | tr -d ' ' | cut -d: -f2 || echo "21")
    # Drop the "+build" suffix (e.g. jdk-25.0.3+9 -> 25.0.3): `java -version`
    # reports only the X.Y.Z version, so keeping the build would make an
    # up-to-date JDK compare as perpetually outdated.
    LATEST=$(curl -s --max-time 10 "https://api.adoptium.net/v3/assets/feature_releases/${LTS_VER}/ga?architecture=${JDK_ARCH}&image_type=jdk&os=mac&vendor=eclipse" | grep -o '"release_name": "[^"]*"' | head -n 1 | cut -d'"' -f4 | sed 's/^jdk-//' | cut -d+ -f1 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/jdk"
) &

(
    LATEST=$(curl -s --max-time 10 https://downloads.claude.ai/releases/darwin/universal/RELEASES.json | grep -o '"currentRelease":"[^"]*"' | head -n 1 | cut -d'"' -f4 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/claude"
) &

(
    LATEST=$(curl -s --max-time 10 https://static.rust-lang.org/dist/channel-rust-stable.toml | grep -A 2 '\[pkg.rust\]' | grep 'version =' | cut -d'"' -f2 | cut -d' ' -f1 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/rust"
) &

(
    # MongoDB's own download centre, not the cask: install_compass builds a
    # downloads.mongodb.com URL from this value, so it should be MongoDB's
    # newest build rather than whatever brew last bumped to. The feed also lists
    # Beta and the Readonly/Isolated editions, so match only bare "X.Y.Z (Stable)"
    # and take the highest — the feed's order is not contractual.
    LATEST=$(curl -s --max-time 10 https://info-mongodb-com.s3.amazonaws.com/com-download-center/compass.json | grep -o '"version":"[0-9][0-9.]* (Stable)"' | cut -d'"' -f4 | cut -d' ' -f1 | sort -V | tail -n 1)
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/mongodb-compass.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/compass"
) &

(
    # install_dbeaver builds a dbeaver.io/files/<version>/ URL, and DBeaver's
    # release tags are bare versions (26.2.0) — the same string. Read the tags so
    # a lagging cask can't hide a release that dbeaver.io is already serving.
    LATEST=$(curl -s --max-time 10 https://github.com/dbeaver/dbeaver/releases.atom | grep -o 'releases/tag/[0-9][^"<]*' | head -n 1 | sed 's#releases/tag/##')
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/dbeaver-community.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/dbeaver"
) &

(
    # install_chrome downloads the unversioned googlechrome.dmg, which always
    # serves whatever Google is shipping right now — so ask Google, not the cask
    # (same reasoning as Bun: the cask is bot-updated after the fact, and the
    # display would flip to "newer than latest" for the gap).
    # Note the filter: the plain .../versions endpoint also lists builds that are
    # merely staged for stable (it was offering 153.0.8010.12 while stable served
    # 152.0.7977.83), which would report a phantom upgrade. Only releases with no
    # end time are actually being served — but that still isn't enough: stable
    # rolls out in slices, and the newest live release can be an early-stable
    # experiment served to 0.5% of clients (155.0.8059.12 at "fraction": 0.005
    # while the dmg gave 154.0.8037.93 at "fraction": 1). Reinstalling could never
    # reach it, so the row stayed "Upgrade" forever. Take the release with the
    # largest rollout fraction (newest wins a tie) — that is what the dmg serves.
    # "fraction" precedes "version" inside each release object; a release with
    # no fraction counts as 0 so it only wins when none carry one.
    LATEST=$(curl -s --max-time 10 'https://versionhistory.googleapis.com/v1/chrome/platforms/mac/channels/stable/versions/all/releases?filter=endtime%3Dnone' \
        | awk -F'"' '/"fraction":/ { f = $3; gsub(/[^0-9.eE-]/, "", f) } /"version":/ { print (f == "" ? 0 : f), $4; f = "" }' \
        | grep -E '^[0-9.eE-]+ [0-9][0-9.]*$' | sort -k1,1gr -k2,2Vr | head -n 1 | cut -d' ' -f2)
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/google-chrome.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/chrome"
) &

(
    # Kept on the cask deliberately: install_android_studio downloads the URL out
    # of this same cask JSON, so the cask *is* the install source here — pointing
    # the probe at Google's own feed would report a version we don't install.
    # The cask exposes Google's full marketing version (e.g. "2026.1.1.10,quail1-patch2"),
    # but the installed app's Info.plist only reports its feature-release version
    # (CFBundleShortVersionString, e.g. "2026.1"). Truncate to the feature release
    # (YYYY.N) so the two are comparable — otherwise every check falsely reports an
    # upgrade. Patch updates within a feature release are handled by Android Studio's
    # own auto-updater.
    LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/android-studio.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4 | cut -d',' -f1 | cut -d'.' -f1,2 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/android_studio"
) &

(
    # Cask on purpose: install_codex downloads the URL from this same cask JSON,
    # so probing upstream would advertise a version we would not install.
    LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/codex-app.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/codex"
) &

(
    # Cask on purpose: install_antigravity downloads the URL from this same cask
    # JSON, so probing upstream would advertise a version we would not install.
    LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/antigravity.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4 | cut -d',' -f1 || echo "Unknown")
    echo "$LATEST" > "$TEMP_VER_DIR/antigravity"
) &

(
    # The component manifest for the rapid channel carries the CLI release at its
    # top level ("version": "583.0.0") — the same number `gcloud --version`
    # prints and the same one install_gcloud puts in the tarball name. It is the
    # manifest `gcloud components update` itself reads, so it is the authority
    # the cask is merely copying. The quoted-numeric pattern occurs exactly once
    # in the file (schema_version's "version" is an unquoted 3), and the ~240KB
    # download is fine next to the other probes. Cask as fallback.
    LATEST=$(curl -s --max-time 10 https://dl.google.com/dl/cloudsdk/channels/rapid/components-2.json | grep -o '"version": "[0-9][0-9.]*"' | head -n 1 | cut -d'"' -f4)
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/gcloud-cli.json | grep -o '"version":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/gcloud"
) &

(
    # Read Bun's own releases, not formulae.brew.sh: the brew formula builds bun
    # from source and routinely trails upstream by days (it sat on 1.4.0 while
    # bun.sh was already shipping 1.4.2). install_bun runs bun.sh/install, which
    # always fetches upstream latest, so a brew-derived "latest" can never match
    # what we just installed. Use the releases.atom feed rather than
    # api.github.com, which rate-limits unauthenticated callers to 60/hour.
    # The feed also carries non-release tags (consolidation-step-*), hence the
    # bun-v<digit> filter instead of taking the first entry.
    LATEST=$(curl -s --max-time 10 https://github.com/oven-sh/bun/releases.atom | grep -o 'releases/tag/bun-v[0-9][^"<]*' | head -n 1 | sed 's#releases/tag/bun-v##')
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://formulae.brew.sh/api/formula/bun.json | grep -o '"stable":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/bun"
) &

(
    # Homebrew has no formulae.brew.sh entry (it's the package manager, not a
    # formula), so we read its version from GitHub. Prefer the releases.atom
    # feed served by github.com: unlike api.github.com it is not subject to the
    # 60-requests/hour unauthenticated rate limit that made this the first check
    # to intermittently fail. Fall back to the API only if the feed yields nothing.
    LATEST=$(curl -s --max-time 10 https://github.com/Homebrew/brew/releases.atom | grep -o 'releases/tag/[^"<]*' | head -n 1 | sed 's#releases/tag/##; s/^v//')
    if [ -z "$LATEST" ]; then
        LATEST=$(curl -s --max-time 10 https://api.github.com/repos/Homebrew/brew/releases/latest | grep -o '"tag_name": "[^"]*"' | head -n 1 | cut -d'"' -f4 | sed 's/^v//')
    fi
    echo "$LATEST" > "$TEMP_VER_DIR/homebrew"
) &

# Count updatable global packages next to the version probes above, so the menu
# can flag stale *packages* and not just stale tools.
spawn_global_checks "$TEMP_VER_DIR"

# Spinner loading indicator
show_spinner() {
    local delay=0.1
    local spinstr='|/-\'
    echo -n -e " ${CYAN}Checking for the latest updates...${NC} "
    while [[ -n $(jobs -r 2>/dev/null) ]]; do
        local temp=${spinstr#?}
        printf "[%c]" "$spinstr"
        spinstr=$temp${spinstr%"$temp"}
        sleep $delay
        printf "\b\b\b"
    done
    printf "   \b\b\b\n"
}

# Wait for all background tasks to finish
show_spinner
wait

# Read latest versions
LATEST_BUN=$(cat "$TEMP_VER_DIR/bun" 2>/dev/null || echo "Unknown")
LATEST_GO=$(cat "$TEMP_VER_DIR/go" 2>/dev/null || echo "Unknown")
LATEST_NODE=$(cat "$TEMP_VER_DIR/node" 2>/dev/null || echo "Unknown")
LATEST_ORB=$(cat "$TEMP_VER_DIR/orb" 2>/dev/null || echo "Unknown")
LATEST_VSCODE=$(cat "$TEMP_VER_DIR/vscode" 2>/dev/null || echo "Unknown")
LATEST_PYTHON=$(cat "$TEMP_VER_DIR/python" 2>/dev/null || echo "Unknown")
LATEST_UV=$(cat "$TEMP_VER_DIR/uv" 2>/dev/null || echo "Unknown")
LATEST_JDK=$(cat "$TEMP_VER_DIR/jdk" 2>/dev/null || echo "Unknown")
LATEST_CLAUDE=$(cat "$TEMP_VER_DIR/claude" 2>/dev/null || echo "Unknown")
LATEST_RUST=$(cat "$TEMP_VER_DIR/rust" 2>/dev/null || echo "Unknown")
LATEST_COMPASS=$(cat "$TEMP_VER_DIR/compass" 2>/dev/null || echo "Unknown")
LATEST_DBEAVER=$(cat "$TEMP_VER_DIR/dbeaver" 2>/dev/null || echo "Unknown")
LATEST_CHROME=$(cat "$TEMP_VER_DIR/chrome" 2>/dev/null || echo "Unknown")
LATEST_ANDROID_STUDIO=$(cat "$TEMP_VER_DIR/android_studio" 2>/dev/null || echo "Unknown")
LATEST_CODEX=$(cat "$TEMP_VER_DIR/codex" 2>/dev/null || echo "Unknown")
LATEST_ANTIGRAVITY=$(cat "$TEMP_VER_DIR/antigravity" 2>/dev/null || echo "Unknown")
LATEST_GCLOUD=$(cat "$TEMP_VER_DIR/gcloud" 2>/dev/null || echo "Unknown")
LATEST_HOMEBREW=$(cat "$TEMP_VER_DIR/homebrew" 2>/dev/null || echo "Unknown")
read_global_checks "$TEMP_VER_DIR"
rm -rf "$TEMP_VER_DIR"

# The curl|grep pipelines above yield an empty string (not "Unknown") when the
# network or an API fails — normalize so empty versions never look like upgrades
for v in LATEST_BUN LATEST_GO LATEST_NODE LATEST_ORB LATEST_VSCODE LATEST_PYTHON \
         LATEST_UV LATEST_JDK LATEST_CLAUDE LATEST_RUST LATEST_COMPASS LATEST_DBEAVER \
         LATEST_CHROME LATEST_ANDROID_STUDIO LATEST_CODEX LATEST_ANTIGRAVITY LATEST_GCLOUD \
         LATEST_HOMEBREW; do
    if [ -z "$(eval echo "\$$v")" ]; then
        eval "$v=Unknown"
    fi
done

# Detection helper functions
detect_bun() {
    if [[ -x "$HOME/.bun/bin/bun" ]]; then
        "$HOME/.bun/bin/bun" --version 2>/dev/null | sed 's/^v//' || echo ""
    elif command -v bun &>/dev/null; then
        bun --version 2>/dev/null | sed 's/^v//' || echo ""
    fi
}
detect_go() {
    if [[ -x "$HOME/.local/go/bin/go" ]]; then
        echo "$("$HOME/.local/go/bin/go" version | awk '{print $3}' | sed 's/^go//')"
    fi
}

