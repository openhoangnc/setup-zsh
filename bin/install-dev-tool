install_android_studio() {
    echo -e "${BLUE}Installing Android Studio v${LATEST_ANDROID_STUDIO}...${NC}"
    local download_url
    download_url=$(curl -s --max-time 10 https://formulae.brew.sh/api/cask/android-studio.json | grep -o '"url":"[^"]*"' | head -n 1 | cut -d'"' -f4)
    if [ "$ARCH" = "x86_64" ]; then
        download_url="${download_url/_arm.dmg/.dmg}"
    fi
    local temp_dmg=$(mktemp /tmp/android-studio.XXXXXX)
    
    echo "Downloading ${download_url}..."
    if ! curl -fL --progress-bar "$download_url" -o "$temp_dmg"; then
        echo -e "${RED}Error: Failed to download Android Studio.${NC}"
        return 1
    fi
    
    echo "Mounting DMG..."
    local mount_point="/Volumes/AndroidStudio_temp_$$"
    mkdir -p "$mount_point"
    if ! hdiutil attach -nobrowse -readonly -mountpoint "$mount_point" "$temp_dmg"; then
        echo -e "${RED}Error: Failed to mount Android Studio DMG.${NC}"
        rm -f "$temp_dmg"
        rm -rf "$mount_point"
        return 1
    fi
    
    echo "Copying to Applications..."
    if ! install_app_bundle "${mount_point}/Android Studio.app" "Android Studio.app"; then
        echo -e "${RED}Error: Failed to copy Android Studio to /Applications.${NC}"
        hdiutil detach "$mount_point"
        rm -f "$temp_dmg"
        rm -rf "$mount_point"
        return 1
    fi
    
    echo "Unmounting DMG..."
    hdiutil detach "$mount_point"
    rm -rf "$mount_point"
    rm -f "$temp_dmg"

    echo "Updating env.zsh with Android SDK environment variables..."
    local content="export ANDROID_HOME=\"\$HOME/Library/Android/sdk\"\nexport ANDROID_SDK_ROOT=\"\$HOME/Library/Android/sdk\"\nexport PATH=\"\$ANDROID_HOME/emulator:\$ANDROID_HOME/platform-tools:\$ANDROID_HOME/cmdline-tools/latest/bin:\$ANDROID_HOME/tools:\$ANDROID_HOME/tools/bin:\$PATH\""

    # Android Studio bundles a JetBrains Runtime (a full JDK). Use it as a JAVA_HOME
    # fallback only when nothing else has set it — the Temurin JDK block sets
    # JAVA_HOME unconditionally, so an installed JDK always wins regardless of the
    # order these blocks are sourced. Verify the JBR exists before writing the block,
    # and re-check at shell startup in case Android Studio is later removed.
    local jbr_home="/Applications/Android Studio.app/Contents/jbr/Contents/Home"
    if [[ -d "$jbr_home" ]]; then
        content="${content}\nif [[ -z \"\$JAVA_HOME\" && -d \"${jbr_home}\" ]]; then\n  export JAVA_HOME=\"${jbr_home}\"\n  export PATH=\"\$JAVA_HOME/bin:\$PATH\"\nfi"
    fi
    update_env_block "AndroidStudio" "$content"
    echo -e "${GREEN}✓ Android Studio v${LATEST_ANDROID_STUDIO} installed to /Applications/Android Studio.app!${NC}"
    reopen_app_if_was_running "Android Studio" "/Applications/Android Studio.app" "$WAS_RUNNING_ANDROID_STUDIO"
}

