detect_jdk() {
    # Report the Eclipse Temurin JDK this tool installs (the pkg lands under
    # /Library/Java/JavaVirtualMachines/temurin-*.jdk), independent of $JAVA_HOME
    # and PATH. Android Studio's bundled JetBrains Runtime is exposed via JAVA_HOME
    # as a fallback (see install_android_studio), and macOS's /usr/bin/java honors
    # $JAVA_HOME — so resolving `java` off PATH would misreport the JBR as an
    # outdated Temurin JDK. Pick the highest version if several majors coexist.
    local jdk_home
    jdk_home=$(ls -d /Library/Java/JavaVirtualMachines/temurin-*.jdk/Contents/Home 2>/dev/null | sort -V | tail -n 1)
    if [[ -n "$jdk_home" && -x "$jdk_home/bin/java" ]]; then
        "$jdk_home/bin/java" -version 2>&1 | awk -F '"' '/version/ {print $2}' || echo ""
    fi
}

