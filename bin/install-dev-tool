        "/opt/homebrew/bin/brew" --version 2>/dev/null | head -n1 | awk '{print $2}' || echo ""
    elif [[ -x "/usr/local/bin/brew" ]]; then
        "/usr/local/bin/brew" --version 2>/dev/null | head -n1 | awk '{print $2}' || echo ""
    elif command -v brew &>/dev/null; then
        brew --version 2>/dev/null | head -n1 | awk '{print $2}' || echo ""
    fi
}

